diff --git a/src/utils.test.ts b/src/utils.test.ts
new file mode 100644
index 0000000..2551700
--- /dev/null
+++ b/src/utils.test.ts
@@ -0,0 +1,55 @@
+import { expect, test } from "vitest";
+
+import { AluExp, DType } from "./alu";
+import { FpHash } from "./utils";
+
+test("FpHash is deterministic and separates values of different types", () => {
+  const values = [
+    0,
+    -0,
+    1,
+    -1,
+    2 ** 31,
+    2 ** 40,
+    0.5,
+    NaN,
+    Infinity,
+    -Infinity,
+    "",
+    "0",
+    "1",
+    "ab",
+    "ba",
+    "abc",
+    true,
+    false,
+    null,
+    undefined,
+    0n,
+    1n,
+    2n ** 63n,
+  ];
+  const hashes = values.map((v) => FpHash.hash(v));
+  expect(new Set(hashes).size).toBe(values.length);
+  expect(values.map((v) => FpHash.hash(v))).toEqual(hashes);
+  expect(FpHash.hash(1, 2)).not.toBe(FpHash.hash(2, 1));
+  expect(FpHash.hash("a", "b")).not.toBe(FpHash.hash("ab"));
+});
+
+test("FpHash values fit in 64 bits and spread over both halves", () => {
+  const hashes = Array.from({ length: 2000 }, (_, i) => FpHash.hash(i));
+  expect(new Set(hashes).size).toBe(hashes.length);
+  for (const h of hashes) expect(h >= 0n && h < 2n ** 64n).toBe(true);
+  const highs = new Set(hashes.map((h) => h >> 32n));
+  const lows = new Set(hashes.map((h) => h & 0xffffffffn));
+  expect(highs.size).toBe(hashes.length);
+  expect(lows.size).toBe(hashes.length);
+});
+
+test("expressions hash by structure", () => {
+  const a = AluExp.add(AluExp.f32(1), AluExp.variable(DType.Float32, "x"));
+  const b = AluExp.add(AluExp.f32(1), AluExp.variable(DType.Float32, "x"));
+  const c = AluExp.add(AluExp.f32(2), AluExp.variable(DType.Float32, "x"));
+  expect(a.getHash()).toBe(b.getHash());
+  expect(a.getHash()).not.toBe(c.getHash());
+});
