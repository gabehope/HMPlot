+/**
+ * Hash an AluExp's `arg`: strings, numbers, arrays of them, and hashable
+ * objects (a GlobalView's ShapeTracker) without building a JSON string.
+ */
+function hashArg(state: FpHash, arg: unknown): void {
+  if (Array.isArray(arg)) {
+    state.update("[").update(arg.length);
+    for (const a of arg) hashArg(state, a);
+  } else if (
+    arg === undefined ||
+    arg === null ||
+    typeof arg === "string" ||
+    typeof arg === "number" ||
+    typeof arg === "boolean"
+  ) {
+    state.update(arg);
+  } else if (typeof (arg as FpHashable).hash === "function") {
+    (arg as FpHashable).hash(state);
+  } else {
+    state.update(JSON.stringify(arg));
+  }
+}
+
