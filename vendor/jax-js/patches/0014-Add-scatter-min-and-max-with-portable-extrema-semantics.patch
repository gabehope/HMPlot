 6 files changed, 143 insertions(+), 15 deletions(-)

diff --git a/src/backend/webgpu/routines.ts b/src/backend/webgpu/routines.ts
index a3875f3..d468008 100644
--- a/src/backend/webgpu/routines.ts
+++ b/src/backend/webgpu/routines.ts
@@ -503,6 +503,44 @@ ${axes.map((a) => `  output[i * ${d}u + ${a}u] = acc${a};`).join("\n")}
   ];
 }
 
+/** Atomic extrema with IEEE NaN propagation and deterministic signed-zero ties. */
+function scatterExtremumWgsl(dtype: DType, op: ScatterOp): ScatterUpdateSource {
+  const minimum = op === ScatterOp.Min;
+  if (dtype === DType.Int32 || dtype === DType.Uint32 || dtype === DType.Bool)
+    return { statement: `atomic${minimum ? "Min" : "Max"}(&output[output_index], updates[global]);`, helpers: "" };
+  if (dtype !== DType.Float32 && dtype !== DType.Float16)
+    throw new Error(`Unsupported atomic Scatter dtype for WebGPU: ${dtype}`);
+  const choose = `
+fn extremum_bits(a: u32, b: u32) -> u32 {
+  if ((a & 0x7fffffffu) > 0x7f800000u || (b & 0x7fffffffu) > 0x7f800000u) {
+    return 0x7fc00000u;
+  }
+  if ((a & 0x7fffffffu) == 0u && (b & 0x7fffffffu) == 0u) {
+    return a ${minimum ? "|" : "&"} b;
+  }
+  return select(a, b, bitcast<f32>(b) ${minimum ? "<" : ">"} bitcast<f32>(a));
+}`;
+  const half = dtype === DType.Float16;
+  return {
+    statement: half
+      ? "atomic_extremum(&output[output_index / 2u], output_index % 2u != 0u, f32(updates[global]));"
+      : "atomic_extremum(&output[output_index], updates[global]);",
+    helpers: choose + `
+fn atomic_extremum(address: ptr<storage, atomic<u32>, read_write>, ${half ? "high: bool, " : ""}value: f32) {
+  var old_bits = atomicLoad(address);
+  loop {
+    ${half ? `var pair = unpack2x16float(old_bits);
+    if (high) { pair.y = bitcast<f32>(extremum_bits(bitcast<u32>(pair.y), bitcast<u32>(value))); }
+    else { pair.x = bitcast<f32>(extremum_bits(bitcast<u32>(pair.x), bitcast<u32>(value))); }
+    let new_bits = pack2x16float(pair);` : "let new_bits = extremum_bits(old_bits, bitcast<u32>(value));"}
+    let result = atomicCompareExchangeWeak(address, old_bits, new_bits);
+    if (result.exchanged) { break; }
+    old_bits = result.old_value;
+  }
+}`,
+  };
+}
+
 function createScatter(
   device: GPUDevice,
   type: RoutineType,
@@ -568,12 +606,19 @@ function createScatter(
   });
   const outputIndex = outputTerms.join(" + ");
 
-  const atomicAdd = op === ScatterOp.Add && !uniqueIndices;
+  const extremum = op === ScatterOp.Min || op === ScatterOp.Max;
+  const minimum = op === ScatterOp.Min;
+  const atomic = extremum || op === ScatterOp.Add && !uniqueIndices;
+  const outputWords = Math.ceil(prod(outputShape) / (dtype === DType.Float16 ? 2 : 1));
+  const identity = dtype === DType.Float32 ? (minimum ? "0x7f800000u" : "0xff800000u")
+    : dtype === DType.Float16 ? (minimum ? "0x7c007c00u" : "0xfc00fc00u")
+    : dtype === DType.Int32 ? (minimum ? "2147483647i" : "(-2147483647i - 1i)")
+    : dtype === DType.Bool ? (minimum ? "1i" : "0i") : (minimum ? "0xffffffffu" : "0u");
   const usesSignedAtomics = dtype === DType.Int32 || dtype === DType.Bool;
-  const outputStorageType = atomicAdd
+  const outputStorageType = atomic
     ? `atomic<${usesSignedAtomics ? "i32" : "u32"}>`
     : elementType;
-  const updateSource = atomicAdd
+  const updateSource = extremum ? scatterExtremumWgsl(dtype, op) : atomic
     ? scatterAddWgsl(dtype)
     : {
         statement: "output[output_index] = updates[global];",
@@ -589,6 +634,7 @@ function createScatter(
   const code = `
 ${needsF16 ? "enable f16;" : ""}
 ${headerWgsl}
+${extremum ? "@group(1) @binding(0) var<uniform> phase: u32;" : ""}
 ${updateSource.helpers}
 
 @group(0) @binding(0) var<storage, read> updates: array<${elementType}>;
@@ -603,6 +649,10 @@ ${indexViews
 @compute @workgroup_size(${workgroupSize})
 fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
   let global = global_id.x + global_id.y * ${gridOffsetY * workgroupSize}u;
+  ${extremum ? `if (phase == 0u) {
+    if (global < ${outputWords}u) { atomicStore(&output[global], ${identity}); }
+    return;
+  }` : ""}
   if (global >= ${updateCount}u) {
     return;
   }
@@ -620,9 +670,12 @@ ${indexLoads.join("\n")}
       code,
       numInputs: type.inputShapes.length,
       numOutputs: 1,
-      hasUniform: false,
-      clearOutputs: true,
-      passes: [{ grid: calculateGrid(Math.ceil(updateCount / workgroupSize)) }],
+      hasUniform: extremum,
+      clearOutputs: !extremum,
+      passes: extremum ? [
+        { grid: calculateGrid(Math.ceil(outputWords / workgroupSize)), uniform: new Uint8Array(new Uint32Array([0]).buffer) },
+        { grid: calculateGrid(Math.ceil(updateCount / workgroupSize)), uniform: new Uint8Array(new Uint32Array([1]).buffer) },
+      ] : [{ grid: calculateGrid(Math.ceil(updateCount / workgroupSize)) }],
     },
   ];
 }
