diff --git a/test/lax.test.ts b/test/lax.test.ts
index 0cca393..27c2ae3 100644
--- a/test/lax.test.ts
+++ b/test/lax.test.ts
@@ -1,4 +1,4 @@
-import { defaultDevice, devices, init, lax, numpy as np } from "@jax-js/jax";
+import { defaultDevice, devices, init, jit, jvp, lax, numpy as np } from "@jax-js/jax";
 import { beforeEach, expect, suite, test } from "vitest";
 
 const devicesAvailable = await init();
@@ -132,6 +132,62 @@ suite.each(devices)("device:%s", (device) => {
       expect(columns.js()).toEqual([[2, 0, 1], [4, 0, 3]]);
     });
 
+    for (const mode of ["min", "max"] as const) {
+      test(`${mode} uses extrema identities, repeated indices, and out-of-range skips`, () => {
+        for (const dtype of [np.float32, np.int32, np.uint32]) {
+          const minimum = mode === "min";
+          const identity = dtype === np.float32 ? (minimum ? Infinity : -Infinity)
+            : dtype === np.int32 ? (minimum ? 2147483647 : -2147483648) : minimum ? 4294967295 : 0;
+          const result = lax.scatter(np.array([4, 2, 7, 8, 9, 99], { dtype }),
+            np.array([1, 1, 0, 3, -1, 5], { dtype: np.int32 }), [5], { mode });
+          expect(result.js()).toEqual([7, minimum ? 2 : 4, identity, 8, identity]);
+          expect(lax.scatter(np.array([], { dtype }), np.array([], { dtype: np.int32 }), [3], { mode }).js())
+            .toEqual([identity, identity, identity]);
+        }
+      });
+      test(`${mode} preserves NaN, infinities and signed-zero ties in either order`, () => {
+        const values = [NaN, 3, 0, -0, Infinity, -Infinity, -4, 2, Infinity];
+        const indices = [0, 0, 1, 1, 2, 2, 3, 3, 4];
+        for (const reverse of [false, true]) {
+          const result = lax.scatter(np.array(reverse ? values.toReversed() : values),
+            np.array(reverse ? indices.toReversed() : indices, { dtype: np.int32 }), [6], { mode }).js() as number[];
+          expect(Number.isNaN(result[0])).toBe(true);
+          expect(Object.is(result[1], mode === "min" ? -0 : 0)).toBe(true);
+          expect(result.slice(2)).toEqual(mode === "min" ? [-Infinity, -4, Infinity, Infinity] : [Infinity, 2, Infinity, -Infinity]);
+        }
+      });
+      test(`${mode} handles boolean, half and double precision storage`, () => {
+        expect(lax.scatter(np.array([true, false, true], { dtype: np.bool }),
+          np.array([0, 0, 2], { dtype: np.int32 }), [4], { mode }).js())
+          .toEqual(mode === "min" ? [false, true, true, true] : [true, false, true, false]);
+        const dtypes = device === "cpu" ? [np.float16, np.float64]
+          : device === "wasm" ? [np.float64] : [np.float16];
+        for (const dtype of dtypes) {
+          expect(lax.scatter(np.array([3.5, -2.5, 4], { dtype }),
+            np.array([0, 0, 2], { dtype: np.int32 }), [5], { mode }).js())
+            .toEqual(mode === "min" ? [-2.5, Infinity, 4, Infinity, Infinity]
+              : [3.5, -Infinity, 4, -Infinity, -Infinity]);
+        }
+      });
+      test(`${mode} handles empty outputs and contended singleton outputs repeatedly`, () => {
+        expect(lax.scatter(np.array([1]), np.array([0], { dtype: np.int32 }), [0], { mode }).js()).toEqual([]);
+        const values = Array.from({ length: 4097 }, (_, i) => i - 2048);
+        for (let repeat = 0; repeat < 3; repeat++) {
+          expect(lax.scatter(np.array(values), np.zeros([values.length], { dtype: np.int32 }), [1], { mode }).js())
+            .toEqual([mode === "min" ? -2048 : 2048]);
+        }
+      });
+      test(`${mode} rejects differentiation instead of applying the additive rule`, () => {
+        expect(() => jvp((x) => lax.scatter(x, np.array([0, 0], { dtype: np.int32 }), [1], { mode }),
+          [np.array([2, 3])], [np.array([1, 1])])).toThrow(/differentiation is not supported/);
+      });
+      test(`${mode} scatters along a nonzero axis and under jit`, () => {
+        const run = jit((x, i) => lax.scatter(x, i, [2, 3], { mode, axis: 1 }));
+        expect(run(np.array([[4, 1, 7], [9, 3, 2]]), np.array([1, 1, 0], { dtype: np.int32 })).js())
+          .toEqual(mode === "min" ? [[7, 1, Infinity], [2, 3, Infinity]] : [[7, 4, -Infinity], [2, 9, -Infinity]]);
+      });
+    }
+
     test("checks its arguments", () => {
       expect(() => lax.scatter(np.array([1, 2]), np.array([0, 1]), [3])).toThrow(/int32/);
       expect(() => lax.scatter(np.array([1, 2, 3]), np.array([0, 1], { dtype: np.int32 }), [3])).toThrow(/shape/);
