diff --git a/src/library/lax.ts b/src/library/lax.ts
index 0d8b1ca..3309f92 100644
--- a/src/library/lax.ts
+++ b/src/library/lax.ts
@@ -615,7 +615,9 @@ export function cellPairs(
  * `numpy.take(x, indices, axis)`. Slice `i` of `updates` along `axis` goes to position
  * `indices[i]`; with `mode: "add"` repeated positions accumulate, with `"update"` (the default)
  * one of them wins, in no defined order. Indices outside `[0, shape[axis])` are skipped, so -1
- * can mark an update that goes nowhere.
+ * can mark an update that goes nowhere. `min` and `max` start from positive/negative
+ * infinity (integer extrema, or 1/0 for booleans). They propagate NaN; min chooses -0 and
+ * max +0 when both zero signs occur. Their gradients are not supported.
  *
  * `indices` is a 1D int32 array, and `updates` has `shape` with `axis` replaced by its length.
  */
@@ -623,7 +625,7 @@ export function scatter(
   updates: ArrayLike,
   indices: ArrayLike,
   shape: number[],
-  { axis = 0, mode = "update" }: { axis?: number; mode?: "update" | "add" } = {},
+  { axis = 0, mode = "update" }: { axis?: number; mode?: "update" | "add" | "min" | "max" } = {},
 ): Array {
   updates = fudgeArray(updates);
   indices = fudgeArray(indices);
@@ -638,10 +640,12 @@ export function scatter(
       `scatter: expected 1D int32 indices and updates of shape ${JSON.stringify(expected)}, got ${got}`,
     );
   }
-  if (mode !== "update" && mode !== "add")
-    throw new Error(`scatter: mode must be "update" or "add", got ${JSON.stringify(mode)}`);
+  if (!["update", "add", "min", "max"].includes(mode)) {
+    updates.dispose(); indices.dispose();
+    throw new Error(`scatter: mode must be "update", "add", "min" or "max", got ${JSON.stringify(mode)}`);
+  }
   return core.scatter(updates, [indices], {
-    op: mode === "add" ? ScatterOp.Add : ScatterOp.Update,
+    op: mode as ScatterOp,
     shape,
     axis: [axis],
     outDim: axis,
