From c97b5d68439696cc15e071c9dc921a4a33e342a7 Mon Sep 17 00:00:00 2001
From: Gabe Hope <15705900+gabehope@users.noreply.github.com>
Date: Sat, 17 Oct 2026 02:02:40 -0400
Subject: [PATCH] Materialize routine operands after their view operations

---
 src/frontend/jit.ts | 11 +++++++----
 test/lax.test.ts    |  8 ++++++++
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/frontend/jit.ts b/src/frontend/jit.ts
index 13214b3..1fa77c6 100644
--- a/src/frontend/jit.ts
+++ b/src/frontend/jit.ts
@@ -991,10 +991,13 @@ function splitGraphDataflow(backend: Backend, jaxpr: Jaxpr): Set<Var> {
     Primitive.Pad,
   ];
   for (const eqn of jaxpr.eqns) {
-    if (
-      needsCleanShapePrimitives.includes(eqn.primitive) ||
-      routinePrimitives.has(eqn.primitive)
-    ) {
+    if (routinePrimitives.has(eqn.primitive)) {
+      // Routines consume contiguous buffers, not deferred views of a producer.
+      // Materialize the actual operand, including a slice, reshape or transpose.
+      for (const input of eqn.inputs) {
+        if (input instanceof Var) materializedProducers.add(input);
+      }
+    } else if (needsCleanShapePrimitives.includes(eqn.primitive)) {
       for (const input of eqn.inputs) {
         if (input instanceof Var) markNonViewProducer(input);
       }
diff --git a/test/lax.test.ts b/test/lax.test.ts
index 27c2ae3..382f09f 100644
--- a/test/lax.test.ts
+++ b/test/lax.test.ts
@@ -188,6 +188,14 @@ suite.each(devices)("device:%s", (device) => {
       });
     }
 
+    test("jit materializes sliced updates and indices before a routine", () => {
+      for (const mode of ["update", "add", "min", "max"] as const) {
+        const run = jit((x, i) => lax.scatter(x.slice([1, 3]), i.slice([1, 3]), [2], { mode }));
+        expect(run(np.array([99, 5, 9, 99]), np.array([-1, 0, 1, -1], { dtype: np.int32 })).js())
+          .toEqual([5, 9]);
+      }
+    });
+
     test("checks its arguments", () => {
       expect(() => lax.scatter(np.array([1, 2]), np.array([0, 1]), [3])).toThrow(/int32/);
       expect(() => lax.scatter(np.array([1, 2, 3]), np.array([0, 1], { dtype: np.int32 }), [3])).toThrow(/shape/);
-- 
