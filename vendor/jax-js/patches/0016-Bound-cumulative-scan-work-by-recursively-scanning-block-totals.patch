From fcfdeb6f80697b49d666e01e8fbf9534e89d6053 Mon Sep 17 00:00:00 2001
From: Gabe Hope <15705900+gabehope@users.noreply.github.com>
Date: Sat, 17 Oct 2026 02:04:58 -0400
Subject: [PATCH] Bound cumulative scan work by recursively scanning block
 totals

---
 src/library/numpy.ts | 18 ++++++++++++++----
 test/numpy.test.ts   | 19 +++++++++++++++++++
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/src/library/numpy.ts b/src/library/numpy.ts
index 90ce5d5..e26c32e 100644
--- a/src/library/numpy.ts
+++ b/src/library/numpy.ts
@@ -735,12 +735,13 @@ function cumulativeHelper(
   a = moveaxis(a, axis, -1);
   const n = a.shape[a.ndim - 1];
 
-  const split = 256; // Chunk size for two-stage reduction
+  const split = 256; // Bounded local scan; recursively scan the block totals.
   if (n <= split * 2) {
     return moveaxis(cumulativeQuadratic(op, a, padValue), -1, axis);
   }
-  // Two-stage: scan chunks of `split` independently, then offset each chunk by
-  // an exclusive scan of the chunk totals. Zero-padding the axis up to a
+  // Scan fixed-size chunks independently, then offset each chunk by a recursively
+  // scanned block total. Every level shrinks by `split`: no quadratic tail grows
+  // with the input, and the total work and intermediate storage are linear. Zero-padding the axis up to a
   // multiple of `split` is safe even for products, since the padded tail only
   // reaches outputs that are sliced off and the last chunk's unused total.
   const batch = a.shape.slice(0, -1);
@@ -753,7 +754,16 @@ function cumulativeHelper(
     padValue,
   );
   const totals = scans.ref.slice(...cols, [], -1);
-  const offsets = cumulativeQuadratic(op, totals, padValue, -1);
+  let offsets: Array;
+  if (m <= split * 2) {
+    offsets = cumulativeQuadratic(op, totals, padValue, -1);
+  } else {
+    const inclusive = cumulativeHelper(op, totals, -1);
+    offsets = concatenate([
+      full([...batch, 1], padValue, { dtype: inclusive.dtype }),
+      inclusive.slice(...cols, [0, m - 1]),
+    ], -1);
+  }
   const out =
     op === AluOp.Add
       ? scans.add(offsets.reshape([...batch, m, 1]))
diff --git a/test/numpy.test.ts b/test/numpy.test.ts
index 2e3c137..d63be27 100644
--- a/test/numpy.test.ts
+++ b/test/numpy.test.ts
@@ -346,6 +346,25 @@ suite.each(devices)("device:%s", (device) => {
       ]);
     });
 
+    test("scan preserves integer sums across local and recursive block boundaries", () => {
+      for (const length of [0, 1, 255, 256, 257, 511, 512, 513, 65535, 65536, 65537, 131073]) {
+        for (const dtype of [np.int32, np.uint32]) {
+          const result = np.cumsum(np.ones([length], { dtype }));
+          expect(result.dtype).toBe(dtype);
+          expect(result.js()).toEqual(Array.from({ length }, (_, i) => i + 1));
+        }
+      }
+    }, 90000);
+    test("scan preserves products, nonzero axes and jitted floating sums", () => {
+      const length = 131073;
+      const values = Array.from({ length }, (_, i) => i === 65537 ? 0 : i % 3 ? 1 : -1);
+      let product = 1;
+      const expected = values.map(value => (product *= value) || 0);
+      expect(np.cumprod(np.array(values, { dtype: np.int32 })).js()).toEqual(expected);
+      const scan = jit(x => np.cumsum(x, 0));
+      const input = np.full([513, 2], 0.125);
+      expect(scan(input).js()).toEqual(Array.from({ length: 513 }, (_, i) => [(i + 1) / 8, (i + 1) / 8]));
+    }, 90000);
     test("cumulative product works", () => {
       const x = np.array([1, 2, 3, 4]);
       expect(np.cumprod(x).js()).toEqual([1, 2, 6, 24]);
