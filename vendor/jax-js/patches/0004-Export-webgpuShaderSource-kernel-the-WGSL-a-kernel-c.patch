@@ -365,3 +365,20 @@ export async function devicePut<T extends JsTree<any>>(
   );
   return tree.unflatten(structure, yflat) as any;
 }
+
+/**
+ * The WGSL source the WebGPU backend compiles for a kernel, generated without a GPU (a stand-in
+ * device with shader-f16 and the default limits). Kernels whose sources are equal share one
+ * compiled pipeline, so tests can count what a workload compiles on any backend, for example
+ * from the kernels `prepareKernelSync` receives on the cpu backend.
+ *
+ * @internal Not part of upstream jax-js; added by the heatmaptest fork for its tests.
+ */
+export async function webgpuShaderSource(kernel: Kernel): Promise<string> {
+  const { pipelineSource } = await import("./backend/webgpu");
+  const device = {
+    features: new Set(["shader-f16"]),
+    limits: { maxComputeWorkgroupSizeX: 256 },
+  } as unknown as GPUDevice;
+  return pipelineSource(device, kernel).code;
+}
