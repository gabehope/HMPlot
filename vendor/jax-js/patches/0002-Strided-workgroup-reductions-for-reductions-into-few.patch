--- a/src/tuner.ts
+++ b/src/tuner.ts
@@ -56,8 +56,26 @@ export interface TuneResult {
     /** Amount to upcast in non-reduce dimensions, set via `AluVar.upcast`. */
     upcast?: number;
   };
+
+  /**
+   * The `groups` threads of an output split its reduction by striding: thread
+   * `group` visits ridx = group, group + groups, ... below `size.reduce`,
+   * which is read from a uniform, so lengths share one shader.
