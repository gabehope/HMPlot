+    });
+    await expectOneCompile([80, 513, 4000], async (n) => {
+      // Two outputs, each reducing a row; one masked element per row.
+      const rows = np.broadcastTo(ramp(n), [2, n]);
+      const kept = np.where(rows.ref.notEqual(5), rows, 0);
+      const sums = await np.sum(kept, 1).data();
+      expect(sums[0]).toBeCloseTo((n * (n - 1)) / 2 - 5, -2);
+      expect(sums[1]).toBe(sums[0]);
+    });
+  });
