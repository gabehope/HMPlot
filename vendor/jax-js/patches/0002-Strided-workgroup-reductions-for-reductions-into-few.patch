 }
 
+/** Long reductions into this many outputs or fewer use a strided workgroup. */
+export const STRIDED_MAX_OUTPUTS = 256;
+/**
+ * Reductions at least this long use a strided workgroup. Measured against one
+ * thread per output with a literal trip count: within ~2 us at 64-100 elements,
+ * faster from ~300; and the length is a uniform, so lengths share one shader.
+ */
+export const STRIDED_MIN_REDUCE = 64;
+/** Threads per output in a strided workgroup (the default WebGPU limit). */
+export const STRIDED_GROUPS = 256;
+
 /** Stores dimensions of the kernel's applied shape. Globals start at 0. */
 class TuneDims {
   st: ShapeTracker; // Shape tracker including reduction axes.
@@ -239,10 +257,31 @@ export function tuneNullopt(kernel: Kernel): TuneResult {
   };
 }
 
+/**
+ * Tuning for a long reduction into few outputs: one workgroup per output,
+ * whose threads split the reduction by striding (so the reduction's length
+ * needn't divide by anything, and any op and dtype work).
+ */
+function tuneStrided(kernel: Kernel): TuneResult {
+  const tune = tuneNullopt(kernel);
+  return {
+    ...tune,
+    threadCount: kernel.size * STRIDED_GROUPS,
+    size: { groups: STRIDED_GROUPS, reduce: kernel.reduction!.size },
+    strided: true,
+  };
+}
+
 /** Tuning for WebGPU kernels. */
 export function tuneWebgpu(kernel: Kernel): TuneResult {
   const reduction = kernel.reduction;
   if (!reduction) return tuneNullopt(kernel);
+  if (
+    reduction.size >= STRIDED_MIN_REDUCE &&
+    kernel.size <= STRIDED_MAX_OUTPUTS &&
+    reduction.dtype !== DType.Bool
+  )
+    return tuneStrided(kernel);
 
   const exp = AluExp.cast(reduction.dtype, kernel.exp);
   const globalIndexes = exp.collect((exp) => exp.op === AluOp.GlobalIndex);
