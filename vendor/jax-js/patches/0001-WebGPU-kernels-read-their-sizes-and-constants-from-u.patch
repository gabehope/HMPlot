+/**
+ * One uniform buffer shared by every dispatch. Each submit writes its passes'
+ * uniforms at the start of the buffer: queue.writeBuffer() is ordered after
+ * the submits issued before it, so a write never changes what an earlier
+ * submit reads. Replaces a new uniform buffer per dispatch.
+ */
+class UniformPool {
+  #buffer: GPUBuffer | null = null;
+  #size = 0;
+
+  constructor(readonly device: GPUDevice) {}
+
+  /** Write each pass's uniforms; returns the buffer and the offset stride. */
+  write(uniforms: Uint8Array<ArrayBuffer>[]): [GPUBuffer, number] {
+    for (const buf of uniforms) {
+      if (
+        !buf ||
+        buf.byteLength === 0 ||
+        buf.byteLength !== uniforms[0].byteLength
+      ) {
+        throw new Error("webgpu: Uniform mismatch between shader passes");
+      }
+    }
+    const minAlign = this.device.limits.minUniformBufferOffsetAlignment;
+    const alignment = Math.ceil(uniforms[0].byteLength / minAlign) * minAlign;
+    const size = alignment * uniforms.length;
+    if (!this.#buffer || this.#size < size) {
+      // Destroying a buffer that submitted work still reads is allowed: the
+      // implementation frees it once that work completes.
+      this.#buffer?.destroy();
+      this.#size = Math.max(size, 64 * 1024);
+      this.#buffer = this.device.createBuffer({
+        size: this.#size,
+        usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
+      });
