+import { beforeEach, expect, suite, test } from "vitest";
+
+import { getBackend, init } from "../backend";
+import { numpy as np } from "../index";
+import type { WebGPUBackend } from "./webgpu";
+
+const devicesAvailable = await init();
+
+// Kernels read their sizes and constants from uniforms, so a new length or a
+// new constant reuses the compiled pipeline of an earlier kernel with the same
+// structure.
+suite("webgpu kernels are generic in sizes and values", () => {
+  beforeEach(({ skip }) => {
+    if (!devicesAvailable.includes("webgpu")) skip();
+  });
+
+  const ramp = (n: number) =>
+    np.arange(0, n, 1, { dtype: np.float32, device: "webgpu" });
+  const pipelines = () =>
+    (getBackend("webgpu") as WebGPUBackend).pipelines.cache.size;
+
+  /** Run `f` for each case; every case after the first compiles nothing. */
+  async function expectOneCompile<T>(cases: T[], f: (c: T) => Promise<void>) {
+    await f(cases[0]);
+    const before = pipelines();
+    for (const c of cases.slice(1)) await f(c);
+    expect(pipelines()).toBe(before);
+  }
+
+  test("elementwise: lengths and constants", async () => {
+    await expectOneCompile(
+      [
+        [1000, 2.5, -1],
+        [1003, 7, 3.25],
+        [5, -0.5, 100],
+      ],
+      async ([n, scale, offset]) => {
+        const x = ramp(n);
+        const y = await x.mul(scale).add(offset).data();
+        expect(y.length).toBe(n);
+        for (const i of [0, 1, n - 1])
+          expect(y[i]).toBeCloseTo(i * scale + offset, 3);
+      },
+    );
+  });
+
+  test("slices and concatenation: offsets and lengths", async () => {
+    await expectOneCompile(
+      [
+        [233, 7],
+        [1000, 13],
+        [64, 31],
+      ],
+      async ([n, shift]) => {
+        const x = ramp(n);
+        const shifted = np.concatenate([
+          np.zeros([shift], { device: "webgpu" }),
+          x.slice([0, n - shift]),
+        ]);
+        const y = await shifted.add(2.5).data();
+        expect(y.length).toBe(n);
+        expect(y[shift - 1]).toBe(2.5);
+        expect(y[shift]).toBe(2.5);
+        expect(y[n - 1]).toBe(n - 1 - shift + 2.5);
+      },
+    );
+  });
+
+  test("filled arrays: lengths and values", async () => {
+    // Long enough to fill on the device (short fills are written from the host).
+    await expectOneCompile(
+      [
+        [200, 3],
+        [1000, -7.5],
+        [777, 1e9],
+      ],
+      async ([n, value]) => {
+        const y = await np
+          .full([n], value, {
+            dtype: np.float32,
+            device: "webgpu",
+          })
+          .data();
+        expect(y.length).toBe(n);
+        expect(y[0]).toBe(Math.fround(value));
+        expect(y[n - 1]).toBe(Math.fround(value));
+      },
+    );
+  });
+
+  test("sort and argsort: lengths past one workgroup", async () => {
+    // Shorter arrays size the workgroup to a power of two at least n / 2.
+    const { device } = getBackend("webgpu") as WebGPUBackend;
+    const full = 2 * device.limits.maxComputeWorkgroupSizeX;
+    await expectOneCompile([full + 1, 2 * full, 3 * full - 7], async (n) => {
+      const x = ramp(n).mul(-1); // Descending.
+      const order = await np.argsort(x.ref).data();
+      const sorted = await np.sort(x).data();
+      expect(order[0]).toBe(n - 1);
+      expect(order[n - 1]).toBe(0);
+      expect(sorted[0]).toBe(1 - n);
+      expect(sorted[n - 1] === 0).toBe(true);
+    });
+  });
+
+  test("NaN and infinite constants survive the uniform buffer", async () => {
+    const x = np.array([1, 2, 3], { device: "webgpu" });
+    expect(Array.from(await x.ref.add(NaN).data()).every(Number.isNaN)).toBe(
+      true,
+    );
+    expect(Array.from(await x.mul(-Infinity).data())).toEqual([
+      -Infinity,
+      -Infinity,
+      -Infinity,
+    ]);
+  });
+});
