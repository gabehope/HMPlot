 }
 
+function runCellPairs(
+  type: RoutineType,
+  [position, queryCell, queryValue, sortedPosition, sortedValue, sortedIndex, cellStart, cellEnd, scalars]: DataArray[],
+  [output]: DataArray[],
+  { kind, radius, grid }: CellPairsParams,
+) {
+  const [n, d] = type.inputShapes[0];
+  const minimum2 = scalars[0], maximum2 = scalars[1];
+  const span = 2 * radius + 1, offsets = span ** d;
+  const delta = new Float64Array(d), acc = new Float64Array(d);
+  for (let i = 0; i < n; i++) {
+    acc.fill(0);
+    for (let o = 0; o < offsets; o++) {
+      let flat = 0, stride = 1, inside = true;
+      for (let a = 0; a < d; a++) {
+        const c = Number(queryCell[i * d + a]) + (Math.floor(o / span ** a) % span) - radius;
+        if (c < 0 || c >= grid) {
+          inside = false;
+          break;
+        }
+        flat += c * stride;
+        stride *= grid;
+      }
+      if (!inside) continue;
+      for (let k = Number(cellStart[flat]); k < Number(cellEnd[flat]); k++) {
+        const j = Number(sortedIndex[k]);
+        if (j === i) continue;
+        let d2 = 0;
+        for (let a = 0; a < d; a++) {
+          delta[a] = Number(position[i * d + a]) - Number(sortedPosition[k * d + a]);
+          d2 += delta[a] * delta[a];
+        }
+        if (d2 < 1e-12) {
+          // Coincident points: a small deterministic jitter, antisymmetric in (i, j).
+          d2 = 0;
+          const sign = Math.sign(i - j);
+          for (let a = 0; a < d; a++) {
+            delta[a] = Math.sin((i + j) * 0.731 + a * 1.239) * sign * 0.001;
+            d2 += delta[a] * delta[a];
+          }
+        }
+        if (kind === CellPairsKind.Collide) {
+          const ri = Number(queryValue[i]), rj = Number(sortedValue[k]), r = ri + rj;
+          if (!(d2 < r * r)) continue;
+          const l = Math.sqrt(Math.max(d2, 1e-12));
+          const s = ((r - l) / l) * ((rj * rj) / Math.max(ri * ri + rj * rj, 1e-12));
+          for (let a = 0; a < d; a++) acc[a] += delta[a] * s;
+        } else {
+          if (kind === CellPairsKind.ManyBody && !(d2 < maximum2)) continue;
+          const l =
+            kind === CellPairsKind.ManyBodyLegacy
+              ? Math.max(d2, 1e-3)
+              : d2 < minimum2
+                ? Math.sqrt(minimum2 * d2)
+                : d2;
+          const q = Number(sortedValue[k]) / l;
+          for (let a = 0; a < d; a++) acc[a] -= delta[a] * q;
+        }
+      }
+    }
+    for (let a = 0; a < d; a++) output[i * d + a] = acc[a];
+  }
+}
