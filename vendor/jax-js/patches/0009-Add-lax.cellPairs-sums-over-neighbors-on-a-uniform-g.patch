+/**
+ * Sums over each query's neighbors on a uniform grid of `grid` cells per axis (the near field of
+ * a force layout): for query `i`, every source in the cells within `radius` of `i`'s cell, except
+ * `i`, with the pair function `kind` ("manyBody": d3's, value_j × (p_j - p_i) / l;
+ * "manyBodyLegacy": softened at max(d², 1e-3); "collide": d3's collision). Sources are sorted by
+ * cell: `cellStart` and `cellEnd` (int32, one per cell, x fastest) are each cell's range in
+ * them, and `sortedIndex` (int32) each source's query index. `scalars` is [distanceMin²,
+ * distanceMax²]. Returns [n, d] float32.
+ */
+export function cellPairs(
+  position: ArrayLike,
+  queryCell: ArrayLike,
+  queryValue: ArrayLike,
+  sortedPosition: ArrayLike,
+  sortedValue: ArrayLike,
+  sortedIndex: ArrayLike,
+  cellStart: ArrayLike,
+  cellEnd: ArrayLike,
+  scalars: ArrayLike,
+  { kind, radius = 1, grid }: { kind: "manyBody" | "manyBodyLegacy" | "collide"; radius?: number; grid: number },
+): Array {
+  const args = [position, queryCell, queryValue, sortedPosition, sortedValue, sortedIndex, cellStart, cellEnd, scalars].map(fudgeArray);
+  const [p, cell, value, sp, sv, si, start, end, sc] = args;
+  const fail = (message: string) => {
+    args.forEach((a) => a.dispose());
+    throw new Error(`cellPairs: ${message}`);
+  };
+  if (p.ndim !== 2 || !deepEqual(cell.shape, p.shape)) fail("position and queryCell must be [n, d]");
+  const [n, d] = p.shape;
+  if (value.ndim !== 1 || value.shape[0] !== n) fail("queryValue must be [n]");
+  if (sp.ndim !== 2 || sp.shape[1] !== d) fail("sortedPosition must be [m, d]");
+  const m = sp.shape[0];
+  if (!deepEqual(sv.shape, [m]) || !deepEqual(si.shape, [m])) fail("sortedValue and sortedIndex must be [m]");
+  if (!deepEqual(start.shape, [grid ** d]) || !deepEqual(end.shape, [grid ** d])) fail("cellStart and cellEnd must be [grid^d]");
+  if (!deepEqual(sc.shape, [2])) fail("scalars must be [2]");
+  if (si.dtype !== DType.Int32 || start.dtype !== DType.Int32 || end.dtype !== DType.Int32)
+    fail("sortedIndex, cellStart and cellEnd must be int32");
+  for (const a of [p, cell, value, sp, sv, sc]) if (a.dtype !== DType.Float32) fail("positions, cells, values and scalars must be float32");
+  if (!Object.values(CellPairsKind).includes(kind as CellPairsKind)) fail(`unknown kind ${JSON.stringify(kind)}`);
+  if (!Number.isInteger(radius) || radius < 0 || !Number.isInteger(grid) || grid < 1) fail("radius and grid must be integers");
+  return core.cellPairs(args, { kind: kind as CellPairsKind, radius, grid }) as Array;
+}
