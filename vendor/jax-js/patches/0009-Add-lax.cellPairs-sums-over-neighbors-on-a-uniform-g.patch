+/** The pair function of a `CellPairs` routine. */
+export enum CellPairsKind {
+  /** d3's many-body force: value_j × (p_j - p_i) / l, l = d² (distanceMin × d below it), within distanceMax. */
+  ManyBody = "manyBody",
+  /** A many-body force softened at max(d², 1e-3) (heatmaptest's default charge). */
+  ManyBodyLegacy = "manyBodyLegacy",
+  /** d3's collision: (p_i - p_j) × (r - l) / l × r_j² / (r_i² + r_j²) for overlapping pairs, r = r_i + r_j. */
+  Collide = "collide",
+}
