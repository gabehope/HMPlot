      "source": [
        "import hmplot as hm\n",
        "\n",
        "table = hm.Table({\"group\": [\"A\", \"B\", \"C\", \"D\"], \"total\": [5, 8, 4, 7]})\n",
        "with hm.Plot(x={\"scale\": hm.categorical(domain=[\"A\", \"B\", \"C\", \"D\"])}, data=table, axes2d=True) as plot:\n",
        "    hm.charts.Bar(x=\"group\", y=\"total\", fill=\"group\")\n",
        "plot\n"
      ]
    }
  ],
