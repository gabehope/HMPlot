{
  "name": "ggplot",
  "view": {
    "background": "#ebebeb"
  },
  "typography": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": 14,
    "color": "#333333"
  },
  "axes": {
    "color": "#333333",
    "lineWidth": 0,
    "tickSize": 0,
    "grid": "major-minor",
    "fontSize": 14,
    "titlePosition": "middle",
    "titleAngle": "auto",
    "titlePlacement": "outside",
    "titleOffset": 10,
    "tickLabelAngle": 0,
    "tickLabelAlign": "auto",
    "tickLabelPlacement": "outside",
    "tickLabelOffset": 5,
    "arrow": "none",
    "arrowSize": 5,
    "line": true,
    "ticks": true,
    "tickDirection": "outside",
    "titleFontWeight": 700,
    "gridWidth": 1,
    "gridDash": [],
    "frame": false,
    "mask": true,
    "threeD": {
      "style": "box",
      "gridPlanes": []
    }
  },
  "guides": {
    "fontSize": 14,
    "textColor": "#333333",
    "fontFamily": "Arial, Helvetica, sans-serif"
  },
  "marks": {
    "Line": {
      "color": "#f8766d",
      "width": 1.5
    },
    "Points": {
      "fill": "#f8766d",
      "size": 8,
      "outlineWidth": 0,
      "outlineColor": "#333333",
      "shape": "circle"
    },
    "Area": {
      "fill": "#f8766d",
      "opacity": 0.3
    },
    "ErrorBars": {
      "color": "#333333",
      "width": 1,
      "capSize": 6
    },
    "Text": {
      "color": "#333333",
      "size": 14
    },
    "Segments": {
      "color": "#333333",
      "width": 1,
      "opacity": 1
    },
    "Arrows": {
      "color": "#f8766d",
      "width": 2
    }
  },
  "palette": [
    "#f8766d",
    "#7cae00",
    "#00bfc4",
    "#c77cff",
    "#cd9600",
    "#00be67",
    "#619cff",
    "#ff61cc"
  ],
  "vectorTile": {
    "background": {
      "fill": "#e5e5e5"
    },
    "land": {
      "fill": "#dddddd"
    },
    "green": {
      "fill": "#a0d9bf"
    },
    "water": {
      "fill": "#b1caf3"
    },
    "waterways": {
      "color": "#a6c4f5",
      "width": 1.5
    },
    "buildings": {
      "fill": "#cfcfcf"
    },
    "other": {
      "fill": "#c6c6c6",
      "color": "#8f8f8f",
      "width": 1,
      "size": 5
    },
    "paths": {
      "color": "#f7f7f7",
      "width": 0.8
    },
    "roads": {
      "color": "#ffffff",
      "width": 2
    },
    "majorRoads": {
      "color": "#dbbc6a",
      "width": 3
    },
    "railways": {
      "color": "#a1a1a1",
      "width": 1
    },
    "boundaries": {
      "color": "#d7aef6",
      "width": 1.2
    },
    "places": {
      "color": "#333333",
      "size": 13
    }
  },
  "colormap": "Viridis"
