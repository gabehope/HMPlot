{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","any-interaction-columns",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10,"python":11},"Respond only while active","Interaction","@any_brushed and @any_selected are 1 on every row while anything is brushed or selected, so the other rows shrink only then. Shift-drag or click in either plot; clear to restore every row.",[5,8,9],"Brush","Selection","\u003Cscript>\n  import { Data, Plot, Points, where } from \"hmplot\";\n  const records = Array.from({length: 600}, (_, i) => ({\n    id: i, group: [\"A\", \"B\", \"C\"][i % 3],\n    x: 50 + 40 * Math.sin(i * 0.37) * Math.cos(i * 0.011),\n    y: 50 + 40 * Math.cos(i * 0.23),\n    score: (i * 71) % 100, response: 50 + 35 * Math.sin(i * 0.05),\n  }));\n\u003C/script>\n\u003Cdiv class=\"plots\">\n  \u003CData value={records} key=\"id\">\n    \u003Csection>\u003Ch3>Brush here\u003C/h3>\n      \u003CPlot responsive height={340} axes2d x={{domain: [0, 100]}} y={{domain: [0, 100]}}>\n        \u003CPoints x=\"x\" y=\"y\" fill=\"group\" brush select\n          size={where(\"@any_brushed\", where(\"@brushed\", 4.5, 1), 3)} />\n      \u003C/Plot>\n    \u003C/section>\n    \u003Csection>\u003Ch3>…or here\u003C/h3>\n      \u003CPlot responsive height={340} axes2d x={{domain: [0, 100]}} y={{domain: [0, 100]}}>\n        \u003CPoints x=\"score\" y=\"response\" fill=\"group\" brush select\n          size={where(\"@any_selected\", where(\"@selected\", 7, 1.5), where(\"@any_brushed\", where(\"@brushed\", 4.5, 1), 3))} />\n      \u003C/Plot>\n    \u003C/section>\n  \u003C/Data>\n\u003C/div>","import hmplot as hm\n\nbrushed = hm.where(\"@any_brushed\", hm.where(\"@brushed\", 4.5, 1), 3)\nwith hm.Data(records, key=\"id\") as scope:\n    with hm.Plot(axes2d=True, height=340):\n        hm.Points(x=\"x\", y=\"y\", fill=\"group\", brush=True, select=True, size=brushed)\n    with hm.Plot(axes2d=True, height=340):\n        hm.Points(x=\"score\", y=\"response\", fill=\"group\", brush=True, select=True,\n                         size=hm.where(\"@any_selected\", hm.where(\"@selected\", 7, 1.5), brushed))\nscope",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction dashboard",{"id":39,"title":40},"interaction-matrix","Interaction matrix and scrolling",{"id":42,"title":43},"interaction-keyed-updates","Keyed updates under interaction",{"id":45,"title":46},"data-shortcut","Data shortcuts",{"id":48,"title":49},"scale-resources","Shared and independent scales",{"id":51,"title":52},"layered-signal","Signal and uncertainty",{"id":54,"title":55},"histograms","Histogram bins",{"id":57,"title":58},"violin","Violin plot",{"id":60,"title":61},"twin-axes","Twin coordinate frames",{"id":63,"title":64},"strip-brushing","Brushing frame strips",{"id":66,"title":67},"facets","Facets & transforms",{"id":69,"title":70},"scatterplot-matrix","Scatterplot matrix",{"id":72,"title":73},"coordinated-explorer","Coordinated interaction explorer",{"id":75,"title":76},"enter-exit","Keyed enter and exit",{"id":78,"title":79},"transform-force","Force layout · 2D",{"id":81,"title":82},"timeseries","Long time series",{"id":84,"title":85},"polar-radius","Polar radius",{"id":87,"title":88},"polar-inset","Polar and tangent insets",{"id":90,"title":91},"solar-system","Solar system",{"id":93,"title":94},"earth","Earth relief",{"id":96,"title":97},"manhattan-flyover","Manhattan building flyover",{"id":99,"title":100},"sunburst","Zoomable sunburst",{"id":102,"title":103},"large-graph","Large force graph",{"id":105,"title":106},"themes","Theme presets",[2],{"any-interaction-columns":109},{"sources":110,"views":112},{"svelte":111,"python":111},"",{"plot":113},{"previews":114},{"web":115},{"src":116,"srcset":117,"type":123,"width":120,"height":124,"bytes":125,"alt":6},"gallery/any-interaction-columns/preview-802.14357e7137.webp",[118,121],[119,120],"gallery/any-interaction-columns/preview-401.78beb576b8.webp",401,[116,122],802,"image/webp",332,[126,127],16796,33912],"uses":{"params":["example"]}}]}
