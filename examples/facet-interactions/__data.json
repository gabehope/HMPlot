{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":13,"nav":14,"exampleIds":108,"examples":109},"example","facet-interactions",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":12},"Faceted interaction state","Interaction","Select, hover, and brush in linked facet cells while a detail plot consumes the shared keyed state.",[8,9,10],"Facets","Brush","Selection","\u003CData value={observations} key=\"id\">\n  \u003CFacet column=\"region\" wrap={3} scales=\"shared\" link=\"xy\">\n    \u003CPlot>\u003CPoints x=\"x\" y=\"y\" select hover brush respond={true} />\u003C/Plot>\n  \u003C/Facet>\n  \u003CPlot>\u003CFilter where=\"@selected\" inactive=\"none\">\n    \u003CPoints x=\"x\" y=\"y\" />\u003CText x=\"x\" y=\"y\" text=\"id\" />\n  \u003C/Filter>\u003C/Plot>\n\u003C/Data>","with hm.Data(observations, key=\"id\"):\n    with hm.Facet(column=\"region\", wrap=3, scales=\"shared\", link=\"xy\"):\n        with hm.Plot():\n            hm.Points(x=\"x\", y=\"y\", select=True, hover=True,\n                             brush=True, respond=True)\n    with hm.Plot():\n        with hm.Filter(where=\"@selected\", inactive=\"none\"):\n            hm.Points(x=\"x\", y=\"y\")\n            hm.Text(x=\"x\", y=\"y\", text=\"id\")",false,[15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105],{"id":16,"title":17},"ten-million-stars","Ten million stars, filtered live",{"id":19,"title":20},"double-gyre","Mixing in a double gyre",{"id":22,"title":23},"globe-tiles","A globe with streamed map tiles",{"id":25,"title":26},"lorenz-attractor","Lorenz attractor",{"id":28,"title":29},"earthquakes","Earthquakes beneath the globe",{"id":31,"title":32},"calculate-matrix","Calculated scatterplot matrix",{"id":34,"title":35},"calculate-large","Large calculated point cloud",{"id":37,"title":38},"interaction-dashboard","Coordinated interaction dashboard",{"id":40,"title":41},"interaction-matrix","Interaction m