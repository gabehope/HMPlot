{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","shared-mappings",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":10,"python":11},"Shared mappings","One mapping scope drives positions and styles for points and labels.","Combinations",[8,9],"Data","GPU","\u003Cscript>\n import {Plot,Mapping,Points,Text} from '$lib';\n  import {untrack} from 'svelte';\n  let {plot=$bindable(),onready=undefined}=$props();\n  $effect(()=>{const p=plot;untrack(()=>onready?.(p));});\n const data=[{x:1,y:1,name:'North',group:'A'},{x:2,y:3,name:'East',group:'B'},{x:4,y:2,name:'West',group:'A'}];\n\u003C/script>\n\u003CPlot bind:this={plot} {data} responsive height={400} axes2d x={{domain:[0,6]}} y={{domain:[0,4]}}>\u003CMapping x=\"x\" y=\"y\" fill=\"group\" opacity={.9}>\u003CPoints size={4.5}/>\u003CText text=\"name\" dx={10} align=\"left\" color=\"#30343b\"/>\u003C/Mapping>\u003C/Plot>","import hmplot as hm\nobservations = {'x': [1, 2, 4], 'y': [1, 3, 2], 'name': ['Alder', 'Birch', 'Cedar']}\nwith hm.Plot(data=observations, axes2d=True, x={'domain': [0, 6]}, y={'domain': [0, 4]}) as chart:\n    with hm.Mapping(x='x', y='y', opacity=0.9):\n        hm.Points(size=8, fill='#547ba2')\n        hm.Text(text='name', size=14, dx=8, align='left')\nchart\n",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction d