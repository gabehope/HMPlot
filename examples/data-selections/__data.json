{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":13,"nav":14,"exampleIds":108,"examples":109},"example","data-selections",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":12},"Data selections and brushing","Interaction","Click or brush observations and filter another plot through data-owned virtual fields.",[8,9,10],"Selection","Brush","Filter","\u003CData value={observations} key=\"id\">\n  \u003CPlot>\n    \u003CPoints x=\"x\" y=\"y\" select hover brush respond={true} />\n  \u003C/Plot>\n  \u003CPlot>\n    \u003CFilter where=\"@selected\" inactive=\"all\">\n      \u003CPoints x=\"x\" y=\"y\" fill=\"coral\" />\n    \u003C/Filter>\n  \u003C/Plot>\n\u003C/Data>","import math\nimport hmplot as hm\n\nobservations = hm.Table({\n    'id': [f'sample-{i}' for i in range(30)],\n    'x': [i / 29 for i in range(30)],\n    'y': [0.5 + 0.32 * math.sin(i * 0.75) + 0.12 * math.cos(i * 1.7) for i in range(30)],\n}, key='id')\n\nwith hm.Scene() as scene:\n    with hm.Row(wrap=True, min_width=320):\n        with hm.Plot(data=observations, height=350, axes2d=True) as source:\n            hm.Points(x='x', y='y', size=12, fill='#547ba2',\n                             select=True, hover=True, brush=True, respond=True)\n        with hm.Plot(data=observations, height=350, axes2d=True):\n            with hm.Filter(where='@selected', inactive='all'):\n                hm.Points(x='x', y='y', size=15, fill='#cf8955')\nscene\n",false,[15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105],{"id":16,"title":17},"ten-million-stars","Ten million stars, filtered live",{"id":19,"title":20},"double-gyre","Mixing in a double gyre",{"id":22,"title":23},"globe-tiles","A globe with streamed map tiles",{"id":25,"title":26},"lorenz-attractor","Lorenz attractor",{"id":28,"title":29},"earthquakes","Earthquakes beneath the globe",{"id":31,"title":32},"calculate-matrix","Calculated scatterplot matrix",{"id":34