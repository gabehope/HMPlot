{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":14,"nav":15,"exampleIds":109,"examples":110},"example","mona-lisa-histogram",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":12,"python":13},"Mona Lisa histogram","Composition","Every pixel of the painting is a data-space square with RGB fill, and an RGB histogram sits over its lower part, its three channels screen-blended so overlaps add up to white as in the D3 notebook. Brush a region and the histogram counts only those pixels. After the D3 notebook of the same name.",[8,9,10,11],"RGB","Brush","Bin","Frame","\u003Cscript>\n  import { onMount } from \"svelte\";\n  import { Data, Plot, Frame, Points, Rect } from \"hmplot\";\nimport { Bin } from \"hmplot/stats\";\n  let { onready = () => {} } = $props();\n  let plot = $state(), pixels = $state.raw(), size = $state([250, 373]), error = $state(\"\");\n  const abort = new AbortController();\n  const width = 420, height = $derived(Math.round(width * size[1] / size[0]));\n  // 64 fixed bins over 0-1 keep the axis still while the brush changes.\n  const edges = Array.from({ length: 65 }, (_, i) => i / 64);\n  const channels = [[\"r\", \"#e0301e\"], [\"g\", \"#1a9e3f\"], [\"b\", \"#2360d8\"]];\n\n  onMount(() => {\n    (async () => {\n      const response = await fetch(\"/examples/mona-lisa/mona-lisa.jpg\", { signal: abort.signal });\n      if (!response.ok) throw Error(`Could not load the image (${response.status}).`);\n      const bitmap = await createImageBitmap(await response.blob());\n      const { width: w, height: h } = bitmap;\n      // One-time decoding: one row per pixel, with its position and 0-1 channel values.\n      const context = new OffscreenCanvas(w, h).getContext(\"2d\", { willReadFrequently: true });\n      context.drawImage(bitmap, 0, 0);\n      bitmap.close();\n      const data = context.getImageData(0, 0, w, h).data, n = w * h;\n      const table = { x: new Float32Array(n), y: new Float32Array(n), r: new Float32Array(n), g: new Float32Array(n), b: new Float32Array(n) };\n      for (let i = 0; i \u003C n; i++) {\n        table.x[i] = i % w;\n        table.y[i] = h - 1 - Math.floor(i / w); // image rows run top-down\n        table.r[i] = data[i * 4] / 255; table.g[i] = data[i * 4 + 1] / 255; table.b[i] = data[i * 4 + 2] / 255;\n      }\n      abort.signal.throwIfAborted();\n      size = [w, h];\n      pixels = table;\n    })().catch((e) => { if (!abort.signal.aborted) error = e.message; });\n    return () => abort.abort();\n  });\n  $effect(() => onready(plot));\n\u003C/script>\n\n{#if error}\u003Cp role=\"alert\">{error}\u003C/p>{/if}\n{#if pixels}\n  \u003CData value={pixels}>\n    \u003CPlot bind:this={plot} {width} {height} toneMapping={0} x={{ domain: [0, size[0]] }} y={{ domain: [0, size[1]] }} z={{ domain: [-1, 1] }}>\n      \u003C!-- Size-1 squares in data units tile like pixels at any zoom. -->\n      \u003CPoints x=\"x\" y=\"y\" fill={{ r: \"r\", g: \"g\", b: \"b\" }} shape=\"square\" size={1.6} sizeUnits=\"data\" brush respond={false} />\n      \u003CFrame x={{ domain: [0, 1], range: [0, size[0]] }} y={{ range: [0, size[1] * 0.35] }}>\n        \u003C!-- weight=\"@brushed\" counts brushed pixels (every pixel with no brush) without\n             refiltering, so brushing reuses the same compiled GPU kernels. -->\n        {#each channels as [column, color]}\n          \u003CBin x={column} bins={edges} weight=\"@brushed\">\n            \u003CRect x0=\"x0\" x1=\"x1\" y0={0} y1=\"count\" fill={color} blend=\"screen\" />\n          \u003C/Bin>\n        {/each}\n      \u003C/Frame>\n    \u003C/Plot>\n  \u003C/Data>\n{/if}","import numpy as np\nfrom PIL import Image as PILImage   # pip install pillow\nimport hmplot as hm\n\nimage = np.asarray(PILImage.open(\"mona-lisa.jpg\").convert(\"RGB\"))   # (373, 250, 3) uint8\nh, w, _ = image.shape\nrows, cols = np.mgrid[0:h, 0:w]\npixels = {\"x\": cols.ravel(), \"y\": (h - 1 - rows).ravel(),\n          \"r\": image[..., 0].ravel() / 255, \"g\": image[..., 1].ravel() / 255, \"b\": image[..., 2].ravel() / 255}\nedges = [i / 64 for i in range(65)]\n\nwith hm.Data(pixels) as scope:\n    with hm.Plot(width=420, height=round(420 * h / w), tone_mapping=0,\n                 x={\"domain\": [0, w]}, y={\"domain\": [0, h]}):\n        # Size-1 squares in data units tile like pixels at any zoom.\n        hm.Points(x=\"x\", y=\"y\", fill=hm.rgb(\"r\", \"g\", \"b\"), shape=\"square\", size=1.6,\n                         size_units=\"data\", brush=True, respond=False)\n        with hm.Frame(x={\"domain\": [0, 1], \"range\": [0, w]}, y={\"range\": [0, h * 0.35]}):\n            for column, color in [(\"r\", \"#e0301e\"), (\"g\", \"#1a9e3f\"), (\"b\", \"#2360d8\")]:\n                with hm.stats.Bin(x=column, bins=edges, weight=\"@brushed\"):\n                    hm.Rect(x0=\"x0\", x1=\"x1\", y0=0, y1=\"count\", fill=color, blend=\"screen\")\nscope",false,[16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106],{"id":17,"title":18},"ten-million-stars","Ten million stars, filtered live",{"id":20,"title":21},"double-gyre","Mixing in a double gyre",{"id":23,"title":24},"globe-tiles","A globe with streamed map tiles",{"id":26,"title":27},"lorenz-attractor","Lorenz attractor",{"id":29,"title":30},"earthquakes","Earthquakes beneath the globe",{"id":32,"title":33},"calculate-matrix","Calculated scatterplot matrix",{"id":35,"title":36},"calculate-large","Large calculated point cloud",{"id":38,"title":39},"interaction-dashboard","Coordinated interaction dashboard",{"id":41,"title":42},"interaction-matrix","Interaction matrix and scrolling",{"id":44,"title":45},"interaction-keyed-updates","Keyed updates under interaction",{"id":47,"title":48},"data-shortcut","Data shortcuts",{"id":50,"title":51},"scale-resources","Shared and independent scales",{"id":53,"title":54},"layered-signal","Signal and uncertainty",{"id":56,"title":57},"histograms","Histogram bins",{"id":59,"title":60},"violin","Violin plot",{"id":62,"title":63},"twin-axes","Twin coordinate frames",{"id":65,"title":66},"strip-brushing","Brushing frame strips",{"id":68,"title":69},"facets","Facets & transforms",{"id":71,"title":72},"scatterplot-matrix","Scatterplot matrix",{"id":74,"title":75},"coordinated-explorer","Coordinated interaction explorer",{"id":77,"title":78},"enter-exit","Keyed enter and exit",{"id":80,"title":81},"transform-force","Force layout · 2D",{"id":83,"title":84},"timeseries","Long time series",{"id":86,"title":87},"polar-radius","Polar radius",{"id":89,"title":90},"polar-inset","Polar and tangent insets",{"id":92,"title":93},"solar-system","Solar system",{"id":95,"title":96},"earth","Earth relief",{"id":98,"title":99},"manhattan-flyover","Manhattan building flyover",{"id":101,"title":102},"sunburst","Zoomable sunburst",{"id":104,"title":105},"large-graph","Large force graph",{"id":107,"title":108},"themes","Theme presets",[2],{"mona-lisa-histogram":111},{"sources":112,"views":114},{"svelte":113,"python":113},"",{"plot":115},{"previews":116},{"web":117},{"src":118,"srcset":119,"type":125,"width":122,"height":126,"bytes":127,"alt":6},"gallery/mona-lisa-histogram/preview-840.08a76b2322.webp",[120,123],[121,122],"gallery/mona-lisa-histogram/preview-420.c02b17485a.webp",420,[118,124],840,"image/webp",627,[128,129],39336,99876],"uses":{"params":["example"]}}]}
