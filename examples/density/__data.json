{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","density",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":10,"python":11},"Density estimation","Grouped 1D and raster 2D Gaussian kernel density estimates.","Interaction",[8,9],"Density","Transforms","\u003CDensity x=\"value\" by=\"group\">\u003CLine x=\"x\" y=\"density\" />\u003C/Density>","import hmplot as hm\nimport numpy as np\n\nvalues = hm.Table({\"group\": [\"A\", \"B\"] * 120, \"value\": np.sin(np.arange(240) * 1.7) + np.tile([-1, 1], 120)})\nwith hm.Scene() as scene:\n    with hm.Controls():\n        hm.Slider(name=\"bandwidth\", min=0.02, max=0.5, step=0.01, value=0.15, label=\"Bandwidth\")\n    with hm.Plot(data=values, axes2d=True, height=420):\n        with hm.Density(x=\"value\", by=\"group\", resolution=256, bandwidth=hm.input.bandwidth):\n            hm.Line(x=\"x\", y=\"density\", color=\"group\", width=2)\nscene\n",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction dashboard",{"id":39,"title":40},"interaction-matrix","Interaction matrix and scrolling",{"id":42,"title":43},"interaction-keyed-updates","Keyed updates under interaction",{"id":45,"title":46},"data-shortcut","Data shortcuts",{"id":48,"title":49},"scale-resources","Shared and independent scales",{"id":51,"title":52},"layered-signal","Signal and uncertai