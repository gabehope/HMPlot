{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","map-projections",{"id":2,"title":4,"tags":5,"group":7,"description":9,"code":10,"python":11},"World map projections",[6,7,8],"GeoJSON","Maps","Projections","equal-earth and natural-earth world maps, albers (conic equal-area) and albers-usa (the United States with Alaska and Hawaii as insets): each maps longitude and latitude jointly into one curved outline around its center, cut at its seam, with a graticule and outline instead of edge axes. Move the center to move the seam; click a country for the longitude and latitude under the pointer.","\u003Cscript>\n  // World map projections with curved outlines (TODO 39.5-39.6): equal-earth and natural-earth\n  // for world maps, albers (conic equal-area) and albers-usa (the United States with Alaska and\n  // Hawaii as insets). A graticule and the map's outline replace the edge axes.\n  import { onMount } from \"svelte\";\n  import { Plot, GeoJSON, InputContext, Select, Slider } from \"hmplot\";\n  const loadCountries = async () => { const response = await fetch(\"/data/geo/countries.json\"); if (!response.ok) throw Error(\"Could not load countries.\"); return response.json(); };\n  let { onready } = $props();\n  let countries = $state(), error = $state(\"\"), plot = $state(), mark = $state(), picked = $state(\"\");\n  let projection = $state(\"equal-earth\"), center = $state(0);\n  const projections = [\"equal-earth\", \"natural-earth\", \"albers\", \"albers-usa\", \"equirectangular\"];\n  $effect(() => { if (plot) onready?.(plot); });\n  $effect(() => {\n    if (!import.meta.env.DEV || !plot || !mark) return;\n    window.__projections = { plot, mark };\n    return () => { delete window.__projections; };\n  });\n  onMount(() => {\n    const cancel = new AbortController();\n    loadCountries(cancel.signal).then((data) => (countries = data))\n      .catch((e) => { if (e.name !== \"AbortError\") error = e.message; });\n    return () => cancel.abort();\n  });\n\u003C/script>\n\n\u003CInputContext>\n\u003Cdiv class=\"controls\">\n  \u003CSelect name=\"projection\" label=\"Projection\" options={projections} bind:value={projection} />\n  \u003CSlider name=\"center\" label=\"Center longitude\" min={-180} max={180} step={5}\n    format={(value) => `${value}°`} bind:value={center} />\n  \u003Cspan aria-live=\"polite\">{picked}\u003C/span>\n\u003C/div>\n{#if error}\u003Cp role=\"alert\">{error}\u003C/p>{:else if countries}\n  \u003C!-- albers centers on the United States' latitude, as d3.geoAlbers does. -->\n  \u003CPlot bind:this={plot} responsive height={440} type=\"2d\" coordinates=\"spherical\" {projection}\n    projectionCenter={[projection === \"albers\" ? center - 96 : center, projection === \"albers\" ? 38.7 : 0]} axes2d>\n    \u003CGeoJSON bind:this={mark} data={countries} fill=\"continent\"\n      onclick={(event) => (picked = `${event.feature.properties.name}: ${event.geographicCoordinates\n        ?.map((value) => value.toFixed(1)).join(\"°, \")}°`)} />\n  \u003C/Plot>\n{:else}\u003Cp>Loading map…\u003C/p>{/if}\n\u003Csmall>Natural Earth · public domain.\u003C/small>\n\u003C/InputContext>\n\n\u003Cstyle>\n  .controls { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 8px; font: 13px system-ui; }\n\u003C/style>\n","import hmplot as hm\n\n# countries: a GeoJSON FeatureCollection with a \"continent\" property per country.\nwith hm.Plot(coordinates=\"spherical\", projection=\"equal-earth\", projection_center=[150, 0],\n             type=\"2d\", height=440, axes2d=True) as plot:\n    hm.GeoJSON(data=countries, fill=\"continent\")\nplot",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction dashboard",{"id":39,"title":40},"interaction-matrix","Interaction matrix and scrolling",{"id":42,"title":43},"interaction-keyed-updates","Keyed updates under interaction",{"id":45,"title":46},"data-shortcut","Data shortcuts",{"id":48,"title":49},"scale-resources","Shared and independent scales",{"id":51,"title":52},"layered-signal","Signal and uncertainty",{"id":54,"title":55},"histograms","Histogram bins",{"id":57,"title":58},"violin","Violin plot",{"id":60,"title":61},"twin-axes","Twin coordinate frames",{"id":63,"title":64},"strip-brushing","Brushing frame strips",{"id":66,"title":67},"facets","Facets & transforms",{"id":69,"title":70},"scatterplot-matrix","Scatterplot matrix",{"id":72,"title":73},"coordinated-explorer","Coordinated interaction explorer",{"id":75,"title":76},"enter-exit","Keyed enter and exit",{"id":78,"title":79},"transform-force","Force layout · 2D",{"id":81,"title":82},"timeseries","Long time series",{"id":84,"title":85},"polar-radius","Polar radius",{"id":87,"title":88},"polar-inset","Polar and tangent insets",{"id":90,"title":91},"solar-system","Solar system",{"id":93,"title":94},"earth","Earth relief",{"id":96,"title":97},"manhattan-flyover","Manhattan building flyover",{"id":99,"title":100},"sunburst","Zoomable sunburst",{"id":102,"title":103},"large-graph","Large force graph",{"id":105,"title":106},"themes","Theme presets",[2],{"map-projections":109},{"sources":110,"views":112},{"svelte":111,"python":111},"",{"plot":113},{"previews":114},{"web":115},{"src":116,"srcset":117,"type":123,"width":120,"height":124,"bytes":125,"alt":9},"gallery/map-projections/preview-1636.bdf7b661c9.webp",