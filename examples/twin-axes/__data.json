{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":104,"examples":105},"example","twin-axes",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10},"Twin coordinate frames","Interaction","Composable data scopes, coordinate frames, and shared navigation.",[8,9],"Data","Axes","\u003CPlot>…\u003C/Plot>",true,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"id":38,"title":39},"interaction-matrix","Interaction matrix and scrolling",{"id":41,"title":42},"interaction-keyed-updates","Keyed updates under interaction",{"id":44,"title":45},"data-shortcut","Data shortcuts",{"id":47,"title":48},"scale-resources","Shared and independent scales",{"id":50,"title":51},"layered-signal","Signal and uncertainty",{"id":53,"title":54},"histograms","Histogram bins",{"id":56,"title":57},"violin","Violin plot",{"id":2,"title":4},{"id":60,"title":61},"strip-brushing","Brushing frame strips",{"id":63,"title":64},"facets","Facets & transforms",{"id":66,"title":67},"scatterplot-matrix","Scatterplot matrix",{"id":69,"title":70},"coordinated-explorer","Coordinated interaction explorer",{"id":72,"title":73},"enter-exit","Keyed enter and exit",{"id":75,"title":76},"transform-force","Force layout · 2D",{"id":78,"title":79},"timeseries","Long time series",{"id":81,"title":82},"polar-radius","Polar radius",{"id":84,"title":85},"polar-inset","Polar and tangent insets",{"id":87,"title":88},"solar-system","Solar system",{"id":90,"title":91},"earth","Earth relief",{"id":93,"title":94},"manhattan-flyover","Manhattan building flyover",{"id":96,"title":97},"sunburst","Zoomable sunburst",{"id":99,"title":100},"large-graph","Large force graph",{"id":102,"title":103},"themes","Theme presets",[2],{"twin-axes":106},{"sources":107,"views":110,"files":144},{"svelte":108,"python":109},"\u003Cscript>\n  import { Plot, Frame, Line, Minimap } from \"hmplot\";\n\n  // A day of weather on two y axes over one hour axis: each Frame has a y scale of its own,\n  // temperature on the left and rainfall on the right. The minimap below shows the whole day;\n  // drag its window, or zoom the plot, and both lines move together. Its labels follow the\n  // rainfall frame's axis.\n  const hour = Array.from({ length: 25 }, (_, i) => i);\n  const weather = {\n    hour,\n    temperature: hour.map((h) => 15 + 8 * Math.sin((h / 24) * 2 * Math.PI)),\n    rain: hour.map((h) => Math.max(0, 12 * Math.cos(h / 5))),\n  };\n  let plot = $state(), rainfall = $state();\n\u003C/script>\n\n\u003Cdiv class=\"scene\">\n  \u003CPlot bind:this={plot} data={weather} height={420} legend>\n    \u003CFrame name=\"Temperature\" x={{ domain: [0, 24], label: \"Hour\" }} y={{ domain: [5, 25], label: \"Temperature · °C\" }}>\n      \u003CLine x=\"hour\" y=\"temperature\" color=\"#547ba2\" label=\"Temperature\" />\n    \u003C/Frame>\n    \u003CFrame bind:this={rainfall} name=\"Rainfall\" x={{ domain: [0, 24], visible: false }}\n      y={{ domain: [0, 15], label: \"Rainfall · mm\", side: \"right\" }}>\n      \u003CLine x=\"hour\" y=\"rain\" color=\"#cf8955\" label=\"Rainfall\" />\n    \u003C/Frame>\n  \u003C/Plot>\n  \u003CMinimap for={plot} axis={rainfall} width={600} height={100} axes={{ x: true, y: false }} />\n\u003C/div>\n\n\u003Cstyle>\n  /* Python's Scene: its children stacked 16 px apart. */\n  .scene { display: flex; flex-direction: column; gap: 16px; }\n\u003C/style>\n","import numpy as np\nimport hmplot as hm\n\n# A day of weather on two y axes over one hour axis: each Frame has a y scale of its own,\n# temperature on the left and rainfall on the right. The minimap below shows the whole day; drag\n# its window, or zoom the plot, and both lines move together. Its labels follow the rainfall\n# frame's axis.\nhour = np.arange(25)\nweather = {\n    \"hour\": hour,\n    \"temperature\": 15 + 8 * np.sin(hour / 24 * 2 * np.pi),\n    \"rain\": np.maximum(0, 12 * np.cos(hour / 5)),\n}\n\nwith hm.Scene() as scene:\n    with hm.Plot(data=weather, height=420, legend=True) as plot:\n        with hm.Frame(name=\"Temperature\", x={\"domain\": [0, 24], \"label\": \"Hour\"},\n                      y={\"domain\": [5, 25], \"label\": \"Temperature · °C\"}):\n            hm.Line(x=\"hour\", y=\"temperature\", color=\"#547ba2\", label=\"Temperature\")\n        with hm.Frame(name=\"Rainfall\", x={\"domain\": [0, 24], \"visible\": False},\n                      y={\"domain\": [0, 15], \"label\": \"Rainfall · mm\", \"side\": \"right\"}) as rainfall:\n            hm.Line(x=\"hour\", y=\"rain\", color=\"#cf8955\", label=\"Rainfall\")\n    hm.Minimap(target=plot, axis=rainfall, width=600, height=100, axes={\"x\": True, \"y\": False})\nscene\n",{"plot":111,"tree":135},{"payload":112,"previews":113},"twin-axes/payload.4158993211.json",{"web":114,"thumbnail":121},{"alt":115,"width":116,"height":117,"src":118,"type":119,"bytes":120},"Line chart of temperature against hour, with line chart of rain against hour. x from -1 to 1, y from -1 to 1. 25 rows.",818,536,"twin-axes/preview.f5adf5cd27.svg","image/svg+xml",94020,{"alt":115,"width":122,"height":123,"src":124,"srcset":125,"type":130,"bytes":131,"background":134},305,200,"twin-axes/thumbnail-610.a3e71f4e40.webp",[126,128],[127,122],"twin-axes/thumbnail-305.81a2f69a8a.webp",[124,129],610,"image/webp",[132,133],4500,10746,"#ffffff",{"payload":136,"previews":137},"twin-axes/tree.6493e4c26d.json",{"web":138},{"alt":139,"width":140,"height":141,"src":142,"type":119,"bytes":143},"Visualization tree. Scatter plot, colored by group (Plot and layout, Marks, Interaction), with labels and segments. x from -1.6 to 0.6, y from -4.1 to -0.9. 7 points.",800,460,"twin-axes/tree-preview.8c01d40cb7.svg",7965,[]],"uses":{"params":["example"]}}]}
