{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":106,"examples":107},"example","treemap-hierarchy",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":9,"python":10},"Treemap","D3 treemap bounds from a weighted hierarchy.","Combinations",[4,8],"Hierarchy","\u003CGraphData>\u003CTreemap root=\"Root\" value=\"weight\">\u003CNodes>\u003CRect x0=\"x0\" x1=\"x1\" y0=\"y0\" y1=\"y1\" />\u003C/Nodes>\u003C/Treemap>\u003C/GraphData>","import hmplot as hm\n\nedges = {'source': ['Root', 'Root', 'A', 'A', 'B', 'B'],\n         'target': ['A', 'B', 'A1', 'A2', 'B1', 'B2']}\nnodes = {'id': ['Root', 'A', 'B', 'A1', 'A2', 'B1', 'B2'],\n         'weight': [1, 1, 1, 3, 2, 2, 1],\n         'label': ['', '', '', 'A1', 'A2', 'B1', 'B2']}\nwith hm.Data(edges) as chart:\n    with hm.GraphData(nodes=nodes, edges=edges, node_key='id', source='source', target='target'):\n        with hm.Treemap(root='Root', value='weight', padding_inner=0.01, padding_outer=0.025):\n            with hm.Plot(height=420, x={'domain': [0, 1]}, y={'domain': [0, 1]}):\n                with hm.Nodes():\n                    hm.Rect(x0='x0', x1='x1', y0='y0', y1='y1', fill='depth')\n                    hm.Text(x='x', y='y', text='label', size=11)\nchart\n",false,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"id":38,"title":39},"interaction-matrix","Int