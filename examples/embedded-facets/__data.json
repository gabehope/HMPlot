{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":13,"nav":14,"exampleIds":108,"examples":109},"example","embedded-facets",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":12},"Embedded facets","Composition","Facets inside a Plot partition its frame and share its renderer and camera. For grouped bars, use Bar with arrange=\"group\".",[8,9,10],"Frame","Facet","Bar","\u003Cscript>\n  import { Plot, Facet } from \"hmplot\";\nimport { Bar } from \"hmplot/charts\";\n  const data = {\n    region: [\"North\", \"North\", \"South\", \"South\", \"West\", \"West\"],\n    year: [\"2024\", \"2025\", \"2024\", \"2025\", \"2024\", \"2025\"],\n    total: [12, 18, 9, 15, 21, 25],\n  };\n\u003C/script>\n\u003CPlot {data} responsive height={420} axes2d y={{domain:[0,30]}}>\n  \u003CFacet column=\"region\" bandPadding={0.2}>\n    \u003CBar x=\"year\" y=\"total\" fill=\"year\" />\n  \u003C/Facet>\n\u003C/Plot>","import hmplot as hm\n\ndata = {\n    \"region\": [\"North\", \"North\", \"South\", \"South\", \"West\", \"West\"],\n    \"year\": [\"2024\", \"2025\", \"2024\", \"2025\", \"2024\", \"2025\"],\n    \"total\": [12, 18, 9, 15, 21, 25],\n}\nwith hm.Plot(data=data, height=420, axes2d=True, y={\"domain\": [0, 30]}) as plot:\n    with hm.Facet(column=\"region\", band_padding=0.2):\n        hm.charts.Bar(x=\"year\", y=\"total\", fill=\"year\")\nplot",false,[15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105],{"id":16,"title":17},"ten-million-stars","Ten million stars, filtered live",{"id":19,"title":20},"double-gyre","Mixing in a double gyre",{"id":22,"title":23},"globe-tiles","A globe with streamed map tiles",{"id":25,"title":26},"lorenz-attractor","Lorenz attractor",{"id":28,"title":29},"earthquakes","Earthquakes beneath the globe",{"id":31,"title":32},"calculate-matrix","Calculated scatterplot matrix",{"id":34,"title":35},"calculate-large","Large calculated point cloud",{"id":37,"t