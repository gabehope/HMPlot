{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","moving-particles",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":-1},"Moving particles","Interaction","1,500 particles circle at their own speeds: Slice interpolates every particle's position at the current time on every animation frame, and a slider filters them by speed. Neither playing nor filtering compiles new GPU kernels once warm.",[8,9,10],"Animation","Slice","Filter","\u003Cscript>\n  import { Theme, themes, Data, Plot, Points, Filter, Slice } from \"hmplot\";\n  // table: 90,000 rows: particle, time (0-59), x, y and speed.\n  let time = $state(0), minimum = $state(0.3); // time advances every animation frame\n\u003C/script>\n\u003Cinput type=\"range\" min=\"0\" max=\"0.95\" step=\"0.01\" bind:value={minimum} />\n\u003CTheme value={themes.dark}>\u003CData value={table}>\n  \u003CPlot axes2d x={{ domain: [-1.5, 1.5] }} y={{ domain: [-1.5, 1.5] }}>\n    \u003CFilter where={{ field: \"speed\", op: \"gt\", value: minimum }}>\n      \u003CPoints x=\"x\" y=\"y\" size={1} fill=\"speed\" colormap=\"Plasma\" opacity={0.3}\n        blend=\"additive\" maxElements={90000} />\n      \u003CSlice field=\"time\" at={time} by=\"particle\" values={[\"x\", \"y\", \"speed\"]}>\n        \u003CPoints x=\"x\" y=\"y\" size={3.5} fill=\"speed\" colormap=\"Plasma\" blend=\"additive\" />\n      \u003C/Slice>\n    \u003C/Filter>\n  \u003C/Plot>\n\u003C/Data>\u003C/Theme>",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},