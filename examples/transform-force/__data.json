{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":104,"examples":105},"example","transform-force",{"id":2,"title":4,"tags":5,"group":8,"description":9,"code":10},"Force layout · 2D",[6,7],"Data","Transforms","Interaction","A small team graph laid out by a force simulation on the GPU: run, step, reset, repulsion and dragging.","\u003CData value={observations}>…\u003C/Data>",true,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,77,80,83,86,89,92,95,98,101],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"id":38,"title":39},"interaction-matrix","Interaction matrix and scrolling",{"id":41,"title":42},"interaction-keyed-updates","Keyed updates under interaction",{"id":44,"title":45},"data-shortcut","Data shortcuts",{"id":47,"title":48},"scale-resources","Shared and independent scales",{"id":50,"title":51},"layered-signal","Signal and uncertainty",{"id":53,"title":54},"histograms","Histogram bins",{"id":56,"title":57},"violin","Violin plot",{"id":59,"title":60},"twin-axes","Twin coordinate frames",{"id":62,"title":63},"strip-brushing","Brushing frame strips",{"id":65,"title":66},"facets","Facets & transforms",{"id":68,"title":69},"scatterplot-matrix","Scatterplot matrix",{"id":71,"title":72},"coordinated-explorer","Coordinated interaction explorer",{"id":74,"title":75},"enter-exit","Keyed enter and exit",{"id":2,"title":4},{"id":78,"title":79},"timeseries","Long time series",{"id":81,"title":82},"polar-radius","Polar radius",{"id":84,"title":85},"polar-inset","Polar and tangent insets",{"id":87,"title":88},"solar-system","Solar system",{"id":90,"title":91},"earth","Earth relief",{"id":93,"title":94},"manhattan-flyover","Manhattan building flyover",{"id":96,"title":97},"sunburst","Zoomable sunburst",{"id":99,"title":100},"large-graph","Large force graph",{"id":102,"title":103},"themes","Theme presets",[2],{"transform-force":106},{"sources":107,"views":110,"files":151},{"svelte":108,"python":109},"\u003Cscript>\n  import {\n    InputContext,\n    Checkbox,\n    Button,\n    Slider,\n    Data,\n    Force,\n    Plot,\n    Edges,\n    Segments,\n    Nodes,\n    Points,\n    input,\n    GraphData,\n  } from \"hmplot\";\n\n  // A small team graph laid out by a force simulation on the GPU. Run plays and pauses it; Step\n  // and Reset act on each press (a Button's value counts its presses); Repulsion pushes the nodes\n  // apart. Drag a node to move it.\n  const links = {\n    source: [\"A\", \"A\", \"B\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\"],\n    target: [\"B\", \"C\", \"D\", \"E\", \"F\", \"F\", \"G\", \"H\", \"H\", \"A\"],\n  };\n  const people = {\n    node: [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\"],\n    team: [\"North\", \"North\", \"West\", \"West\", \"East\", \"East\", \"South\", \"South\"],\n  };\n\u003C/script>\n\n\u003CInputContext>\n  \u003Cp>\n    Eight people in four teams, linked by who works with whom, laid out by a\n    force simulation on the GPU. It starts paused: check \u003Cstrong>Run\u003C/strong> to\n    play it, or press \u003Cstrong>Step\u003C/strong> to advance one tick;\n    \u003Cstrong>Reset\u003C/strong>\n    returns to the starting layout. \u003Cstrong>Repulsion\u003C/strong> pushes the nodes apart.\n    Drag a node to move it.\n  \u003C/p>\n  \u003Cdiv class=\"controls\">\n    \u003CCheckbox name=\"run\" label=\"Run\" />\n    \u003CButton name=\"step\" label=\"Step\" />\n    \u003CButton name=\"restart\" label=\"Reset\" />\n    \u003CSlider\n      name=\"repulsion\"\n      min={0}\n      max={200}\n      step={1}\n      value={30}\n      label=\"Repulsion\"\n    />\n  \u003C/div>\n  \u003CData value={links}>\n    \u003CGraphData\n      nodes={people}\n      edges={links}\n      nodeKey=\"node\"\n      source=\"source\"\n      target=\"target\"\n      >\u003CForce\n        dimensions={2}\n        running={input(\"run\")}\n        step={input(\"step\")}\n        reset={input(\"restart\")}\n        repulsion={input(\"repulsion\")}\n      >\n        \u003CPlot\n          height={420}\n          axes2d\n          x={{ domain: [-90, 90] }}\n          y={{ domain: [-90, 90] }}\n        >\n          \u003CEdges>\n            \u003CSegments\n              start=\"start\"\n              end=\"end\"\n              color=\"#8694a0\"\n              width={1}\n            />\n          \u003C/Edges>\n          \u003CNodes drag>\n            \u003CPoints\n              position=\"position\"\n              fill=\"team\"\n              size={14}\n              outlineColor=\"#30343b\"\n              outlineWidth={1.05}\n            />\n          \u003C/Nodes>\n        \u003C/Plot>\n      \u003C/Force>\u003C/GraphData\n    >\n  \u003C/Data>\n\u003C/InputContext>\n\n\u003Cstyle>\n  /* Python's Scene(gap=12) and Row(wrap=True, min_width=0). */\n  .controls {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 16px;\n    margin: 12px 0;\n  }\n\u003C/style>\n","import hmplot as hm\n\n# A small team graph laid out by a force simulation on the GPU. Run plays and pauses it; Step\n# and Reset act on each press (a Button's value counts its presses); Repulsion pushes the nodes\n# apart. Drag a node to move it.\nlinks = {\n    \"source\": [\"A\", \"A\", \"B\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\"],\n    \"target\": [\"B\", \"C\", \"D\", \"E\", \"F\", \"F\", \"G\", \"H\", \"H\", \"A\"],\n}\npeople = {\n    \"node\": [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"G\", \"H\"],\n    \"team\": [\"North\", \"North\", \"West\", \"West\", \"East\", \"East\", \"South\", \"South\"],\n}\n\nwith hm.Scene(gap=12) as scene:\n    hm.Markdown(\"Eight people in four teams, linked by who works with whom, laid out by a force simulation \"\n                \"on the GPU. It starts paused: check **Run** to play it, or press **Step** to advance one \"\n                \"tick; **Reset** returns to the starting layout. **Repulsion** pushes the nodes apart. Drag a \"\n                \"node to move it.\")\n    with hm.Row(wrap=True, min_width=0):\n        hm.Checkbox(name=\"run\", label=\"Run\")\n        hm.Button(name=\"step\", label=\"Step\")\n        hm.Button(name=\"restart\", label=\"Reset\")\n        hm.Slider(name=\"repulsion\", min=0, max=200, step=1, value=30, label=\"Repulsion\")\n    with hm.Data(links):\n        with hm.GraphData(nodes=people, edges=links, node_key=\"node\", source=\"source\", target=\"target\"):\n            with hm.Force(dimensions=2, running=hm.input.run, step=hm.input.step, reset=hm.input.restart, repulsion=hm.input.repulsion):\n                with hm.Plot(height=420, axes2d=True, x={\"domain\": [-90, 90]}, y={\"domain\": [-90, 90]}):\n                    with hm.Edges():\n                        hm.Segments(start=\"start\", end=\"end\", color=\"#8694a0\", width=1)\n                    with hm.Nodes(drag=True):\n                        hm.Points(position=\"position\", fill=\"team\", size=14,\n                                  outline_color=\"#30343b\", outline_width=1.05)\n",{"plot":111,"tree":141},{"payload":112,"previews":113},"transform-force/payload.1e0eb13f55.json",{"web":114,"thumbnail":129},{"alt":115,"width":116,"height":117,"src":118,"srcset":119,"type":124,"bytes":125,"background":128},"Scatter plot, colored by team (North, West, East, South), with segments. x from -90 to 90, y from -90 to 90. 8 points.",818,521,"transform-force/preview-1636.9e6fab90a5.webp",[120,122],[121,116],"transform-force/preview-818.1ee76fd32d.webp",[118,123],1636,"image/webp",[126,127],21330,51512,"#ffffff",{"alt":115,"width":130,"height":131,"src":132,"srcset":133,"type":124,"bytes":138,"background":128},314,200,"transform-force/thumbnail-628.d746c02495.webp",[134,136],[135,130],"transform-force/thumbnail-314.85c34a68e0.webp",[132,137],628,[139,140],5062,12584,{"payload":142,"previews":143},"transform-force/tree.f282b5bcec.json",{"web":144},{"alt":145,"width":146,"height":147,"src":148,"type":149,"bytes":150},"Visualization tree. Scatter plot, colored by group (Plot and layout, Marks, Data sources, Inputs, Graphs), with labels and segments. x from -3 to 4, y from -7.2 to -0.8. 15 points.",800,760,"transform-force/tree-preview.f1d3e3a981.svg","image/svg+xml",13625,[]],"uses":{"params":["example"]}}]}
