{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":104,"examples":105},"example","layered-signal",{"id":2,"title":4,"tags":5,"group":8,"description":9,"code":10},"Signal and uncertainty",[6,7],"Combined","Interactive","Combinations","Animated intervals, estimates, observations, error bars, legends, and an independent overview.","\u003CPlot>…\u003C/Plot>",true,[13,16,19,22,25,28,31,34,37,40,43,46,49,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"id":38,"title":39},"interaction-matrix","Interaction matrix and scrolling",{"id":41,"title":42},"interaction-keyed-updates","Keyed updates under interaction",{"id":44,"title":45},"data-shortcut","Data shortcuts",{"id":47,"title":48},"scale-resources","Shared and independent scales",{"id":2,"title":4},{"id":51,"title":52},"histograms","Histogram bins",{"id":54,"title":55},"violin","Violin plot",{"id":57,"title":58},"twin-axes","Twin coordinate frames",{"id":60,"title":61},"strip-brushing","Brushing frame strips",{"id":63,"title":64},"facets","Facets & transforms",{"id":66,"title":67},"scatterplot-matrix","Scatterplot matrix",{"id":69,"title":70},"coordinated-explorer","Coordinated interaction explorer",{"id":72,"title":73},"enter-exit","Keyed enter and exit",{"id":75,"title":76},"transform-force","Force layout · 2D",{"id":78,"title":79},"timeseries","Long time series",{"id":81,"title":82},"polar-radius","Polar radius",{"id":84,"title":85},"polar-inset","Polar and tangent insets",{"id":87,"title":88},"solar-system","Solar system",{"id":90,"title":91},"earth","Earth relief",{"id":93,"title":94},"manhattan-flyover","Manhattan building flyover",{"id":96,"title":97},"sunburst","Zoomable sunburst",{"id":99,"title":100},"large-graph","Large force graph",{"id":102,"title":103},"themes","Theme presets",[2],{"layered-signal":106},{"sources":107,"views":110,"files":151},{"svelte":108,"python":109},"\u003Cscript>\n  import { InputContext, Button, Checkbox, Plot, Data, Calculate, Area, Line, Points, Minimap, input, col, add, subtract, multiply, sin, cos } from \"hmplot\";\nimport { ErrorBars } from \"hmplot/charts\";\n\n  // A signal and its uncertainty: 512 estimates with a band that widens and narrows, and 32\n  // noisy observations with error bars. \"New target\" moves the signal's phase on by 0.8 (a\n  // Button counts its presses, and Calculate reads the count on the GPU); the plot animates each\n  // change over 700 ms while \"Animate\" is on.\n  const estimates = Array.from({ length: 512 }, (_, i) => ({ x: i / 16, band: 0.12 + 0.25 * Math.sin((i / 16) * 0.35) ** 2 }));\n  const observations = Array.from({ length: 32 }, (_, k) => ({ x: k, noise: 0.08 * Math.sin(k * 7) }));\n\n  const phase = multiply(0.8, input.target);\n  const signal = add(sin(add(col.x, phase)), multiply(0.3, cos(subtract(multiply(col.x, 2.7), phase))));\n  // A Plot's animation is a prop of its own: the Animate checkbox sets it through `animate`.\n  let animate = $state(true), plot = $state();\n\u003C/script>\n\n\u003CInputContext>\n  \u003Cdiv class=\"scene\">\n    \u003Cdiv class=\"controls\">\n      \u003CButton name=\"target\" label=\"New target\" />\n      \u003CCheckbox name=\"animate\" label=\"Animate\" bind:value={animate} />\n    \u003C/div>\n    \u003CPlot bind:this={plot} x={{ domain: [0, 32] }} y={{ domain: [-2, 2] }} height={420} axes2d zoomAxis=\"x\" legend\n      animation={animate} animationDuration={700}>\n      \u003CData value={estimates}>\n        \u003CCalculate columns={{ y: signal, lower: subtract(signal, col.band), upper: add(signal, col.band) }}>\n          \u003CArea opacity={0.2} x=\"x\" lower=\"lower\" upper=\"upper\" fill=\"#577eac\" label=\"Interval\" />\n          \u003CLine x=\"x\" y=\"y\" width={1.5} color=\"#325b83\" label=\"Estimate\" />\n        \u003C/Calculate>\n      \u003C/Data>\n      \u003CData value={observations}>\n        \u003CCalculate columns={{ y: add(signal, col.noise), lower: subtract(signal, 0.18), upper: add(signal, 0.18) }}>\n          \u003CErrorBars x=\"x\" y=\"y\" lower=\"lower\" upper=\"upper\" color=\"#754331\" capSize={5} />\n          \u003CPoints x=\"x\" y=\"y\" fill=\"#b77450\" size={7} outlineColor=\"#fffaf0\"\n            outlineWidth={0.7} label=\"Observations\" />\n        \u003C/Calculate>\n      \u003C/Data>\n    \u003C/Plot>\n    \u003C!-- As wide as the docs' column (narrower screens shrink it): drag its window to move the view. -->\n    \u003CMinimap for={plot} width={818} height={100} axes={{ x: true, y: false }} />\n    \u003Cp>Brush the view with the overview, zoom along X, toggle series, and interrupt animated updates.\u003C/p>\n  \u003C/div>\n\u003C/InputContext>\n\n\u003Cstyle>\n  /* Python's Scene(gap=12) and Row(wrap=True, min_width=0). */\n  .scene { display: flex; flex-direction: column; gap: 12px; }\n  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }\n  p { margin: 0; font-size: 12px; color: #697785; }\n\u003C/style>\n","import numpy as np\nimport hmplot as hm\n\n# A signal and its uncertainty: 512 estimates with a band that widens and narrows, and 32 noisy\n# observations with error bars. \"New target\" moves the signal's phase on by 0.8 (a Button counts\n# its presses, and Calculate reads the count on the GPU); the plot animates each change over\n# 700 ms while \"Animate\" is on.\nx = np.arange(512) / 16\nestimates = {\"x\": x, \"band\": 0.12 + 0.25 * np.sin(x * 0.35) ** 2}\nk = np.arange(32.0)\nobservations = {\"x\": k, \"noise\": 0.08 * np.sin(k * 7)}\n\nphase = 0.8 * hm.input.target\nsignal = hm.sin(hm.col.x + phase) + 0.3 * hm.cos(hm.col.x * 2.7 - phase)\n\nwith hm.Scene(gap=12) as scene:\n    with hm.Row(wrap=True, min_width=0):\n        hm.Button(name=\"target\", label=\"New target\")\n        hm.Checkbox(name=\"animate\", label=\"Animate\", value=True)\n    with hm.Plot(x={\"domain\": [0, 32]}, y={\"domain\": [-2, 2]}, height=420, axes2d=True, zoom_axis=\"x\", legend=True,\n                 animation=hm.input.animate, animation_duration=700) as plot:\n        with hm.Data(estimates):\n            with hm.Calculate(y=signal, lower=signal - hm.col.band, upper=signal + hm.col.band):\n                hm.Area(x=\"x\", lower=\"lower\", upper=\"upper\", fill=\"#577eac\", label=\"Interval\", opacity=0.2)\n                hm.Line(x=\"x\", y=\"y\", width=1.5, color=\"#325b83\",\n                        label=\"Estimate\")\n        with hm.Data(observations):\n            with hm.Calculate(y=signal + hm.col.noise, lower=signal - 0.18, upper=signal + 0.18):\n                hm.charts.ErrorBars(x=\"x\", y=\"y\", lower=\"lower\", upper=\"upper\", color=\"#754331\", cap_size=5)\n                hm.Points(x=\"x\", y=\"y\", fill=\"#b77450\", size=7,\n                          outline_color=\"#fffaf0\", outline_width=0.7, label=\"Observations\")\n    # As wide as the docs' column (narrower screens shrink it): drag its window to move the view.\n    hm.Minimap(target=plot, width=818, height=100, axes={\"x\": True, \"y\": False})\n    hm.Markdown(\"Brush the view with the overview, zoom along X, toggle series, and interrupt animated updates.\",\n                font_size=12, color=\"#697785\")\nscene\n",{"plot":111,"tree":141},{"payload":112,"previews":113},"layered-signal/payload.80b5931e56.json",{"web":114,"thumbnail":129},{"alt":115,"width":116,"height":117,"src":118,"srcset":119,"type":124,"bytes":125,"background":128},"Area chart of x, with line chart of y against x and error bars of x and 1 more layer. x from 0 to 32, y from -2 to 2. 512 rows.",818,562,"layered-signal/preview-1636.ac1cddffbb.webp",[120,122],[121,116],"layered-signal/preview-818.46615ce1ba.webp",[118,123],1636,"image/webp",[126,127],24878,59756,"#ffffff",{"alt":115,"width":130,"height":131,"src":132,"srcset":133,"type":124,"bytes":138,"background":128},320,168,"layered-signal/thumbnail-640.c53ad02b2c.webp",[134,136],[135,130],"layered-signal/thumbnail-320.6b7434eedc.webp",[132,137],640,[139,140],4636,11000,{"payload":142,"previews":143},"layered-signal/tree.b7863a8557.json",{"web":144},{"alt":145,"width":146,"height":147,"src":148,"type":149,"bytes":150},"Visualization tree. Scatter plot, colored by group (Plot and layout, Marks, Interaction, Data sources, Transforms, Inputs), with labels and segments. x from -4 to 4, y from -5.2 to -0.8. 15 points.",800,560,"layered-signal/tree-preview.d9bec4f37c.svg","image/svg+xml",14125,[]],"uses":{"params":["example"]}}]}
