{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":106,"examples":107},"example","partition-density",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":9,"python":10},"One density per group, one frame","Composition","Partition repeats its children once per group inside a single frame, sharing the parent's scales, axes, and legend. Here a Density transform runs per species so the curves overlay; Facet would give each species its own cell instead.",[5,8],"Statistical","\u003Cscript>\n  import { Plot, Partition, Density, Area, Line } from \"hmplot\";\n\u003C/script>\n\u003CPlot data={penguins} responsive height={380} axes2d legend>\n  \u003CPartition by=\"species\" legendGroups>\n    \u003CDensity x=\"bill_length\" resolution={128}>\n      \u003CArea x=\"x\" upper=\"density\" fill=\"species\" opacity={0.35} />\n      \u003CLine x=\"x\" y=\"density\" color=\"species\" width={2} />\n    \u003C/Density>\n  \u003C/Partition>\n\u003C/Plot>","import hmplot as hm\n\nwith hm.Plot(data=penguins, height=380, axes2d=True, legend=True) as plot:\n    with hm.Partition(by=\"species\", legend_groups=True):\n        with hm.Density(x=\"bill_length\", resolution=128):\n            hm.Area(x=\"x\", upper=\"density\", fill=\"species\", opacity=0.35)\n            hm.Line(x=\"x\", y=\"density\", color=\"species\", width=2)\nplot",false,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"int