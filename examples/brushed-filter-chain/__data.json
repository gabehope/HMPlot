{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":106,"examples":107},"example","brushed-filter-chain",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10,"python":-1},"Brushed filter chain","Interaction","Shift-drag to brush 50,000 points; a histogram (Filter > Bin) and per-level means (Filter > Group) follow the brush. A Filter keeps its input's rows and marks the kept ones, so a moving brush changes no array length and compiles no new GPU kernels.",[5,8,9],"Filter","Transforms","\u003Cscript>\n  import { Data, Plot, Points, Filter, Group, Rect, add, mean } from \"hmplot\";\nimport { Bin } from \"hmplot/stats\";\n  // table: 50,000 rows with x, y (to brush), value, and level (the y band, 0-7).\n\u003C/script>\n\u003CData value={table}>\n  \u003CPlot axes2d x={{ domain: [0, 1] }} y={{ domain: [0, 1] }}>\n    \u003CPoints x=\"x\" y=\"y\" size={1} brush maxElements={50000} />\n  \u003C/Plot>\n  \u003CPlot axes2d>\n    \u003CFilter where=\"@brushed\">\n      \u003CBin x=\"value\" bins={32}>\u003CRect x0=\"x0\" x1=\"x1\" y0={0} y1=\"count\" />\u003C/Bin>\n    \u003C/Filter>\n  \u003C/Plot>\n  \u003CPlot axes2d>\n    \u003CFilter where=\"@brushed\">\n      \u003CGroup by=\"level\" columns={{ mean: mean(\"value\") }}>\n        \u003CRect x0=\"level\" x1={add(\"level\", 0.8)} y0={0} y1=\"mean\" />\n      \u003C/Group>\n    \u003C/Filter>\n  \u003C/Plot>\n\u003C/Data>",false,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"id":38,"title":39},"interaction-matrix","Interaction matrix and scrolling",{"id":41,"title":42},"interaction-keyed-updates","Keyed updates under interaction",{"id":44,"title":45},"data-shortcut","Data shortcuts",{"id":47,"title":48},"scale-resources","Shared and independent scales",{"id":50,"title":51},"layered-signal","Signal and uncertainty",{"id":53,"title":54},"histograms","Histogram bins",{"id":56,"title":57},"violin","Violin plot",{"id":59,"title":60},"twin-axes","Twin coordinate frames",{"id":62,"title":63},"strip-brushing","Brushing frame strips",{"id":65,"title":66},"facets","Facets & transforms",{"id":68,"title":69},"scatterplot-matrix","Scatterplot matrix",{"id":71,"title":72},"coordinated-explorer","Coordinated interaction explorer",{"id":74,"title":75},"enter-exit","Keyed enter and exit",{"id":77,"title":78},"transform-force","Force layout · 2D",{"id":80,"title":81},"timeseries","Long time series",{"id":83,"title":84},"polar-radius","Polar radius",{"id":86,"title":87},"polar-inset","Polar and tangent insets",{"id":89,"title":90},"solar-system","Solar system",{"id":92,"title":93},"earth","Earth relief",{"id":95,"title":96},"manhattan-flyover","Manhattan building flyover",{"id":98,"title":99},"sunburst","Zoomable sunburst",{"id":101,"title":102},"large-graph","Large force graph",{"id":104,"title":105},"themes","Theme presets",[2],{"brushed-filter-chain":108},{"sources":109,"views":111},{"svelte":110,"python":110},"",{"plot":112},{"previews":113},{"web":114},{"src":115,"srcset":116,"type":122,"width":119,"height":123,"bytes":124,"alt":6},"gallery/brushed-filter-chain/preview-530.51cdd921ab.webp",[117,120],[118,119],"gallery/brushed-filter-chain/preview-265.4bcd9aee29.webp",265,[115,121],530,"image/webp",320,[125,126],4576,8976],"uses":{"params":["example"]}}]}
