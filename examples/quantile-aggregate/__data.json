{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","quantile-aggregate",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":10,"python":11},"Quantiles and group summaries","Grouped quantile curves and each row's group mean and 90th percentile, all Calculate expressions.","Interaction",[8,9],"Statistics","Transforms","\u003CSort by=\"value\">\u003CCalculate columns={{ probability: divide(cumsum(is_finite(\"value\"), { by: \"group\", orderBy: \"value\" }), count(\"value\", { by: \"group\" })) }}>\u003CLine x=\"probability\" y=\"value\" series=\"group\" color=\"group\" />\u003C/Calculate>\u003C/Sort>","import hmplot as hm\nimport numpy as np\n\ntable = hm.Table({\"group\": [\"A\", \"B\"] * 100, \"value\": np.sin(np.arange(200) * 1.31)})\n# Each group's quantile curve: its rows in value order, each at its share of the group.\nprobability = hm.cumsum(hm.is_finite(\"value\"), by=\"group\", order_by=\"value\") / hm.count(\"value\", by=\"group\")\nwith hm.Data(table) as data:\n    with hm.Sort(by=\"value\"), hm.Calculate(probability=probability, p90=hm.quantile(\"value\", 0.9, by=\"group\")):\n        with hm.Plot(axes2d=True) as plot:\n            hm.Line(x=\"probability\", y=\"value\", series=\"group\", color=\"group\", width=2)\n            hm.charts.RuleY(y=\"p90\", color=\"group\")\nplot\n",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction dashboard",{"id":39,"title":40},"interaction-matrix","Interaction matrix and scrolling",{"id":42,"title":43},"interaction-keyed-updates","Keyed updates under interaction",{"id":45,"title":46},"data-shortcut","Data shortcuts",{"id":48,"title":49},"scale-resources","Shared and independent scales",{"id":51,"title":52},"layered-signal","Signal and uncertainty",{"id":54,"title":55},"histograms","Histogram bins",{"id":57,"title":58},"violin","Violin plot",{"id":60,"title":61},"twin-axes","Twin coordinate frames",{"id":63,"title":64},"strip-brushing","Brushing frame strips",{"id":66,"title":67},"facets","Facets & transforms",{"id":69,"title":70},"scatterplot-matrix","Scatterplot matrix",{"id":72,"title":73},"coordinated-explorer","Coordinated interaction explorer",{"id":75,"title":76},"enter-exit","Keyed enter and exit",{"id":78,"title":79},"transform-force","Force layout · 2D",{"id":81,"title":82},"timeseries","Long time series",{"id":84,"title":85},"polar-radius","Polar radius",{"id":87,"title":88},"polar-inset","Polar and tangent insets",{"id":90,"title":91},"solar-system","Solar system",{"id":93,"title":94},"earth","Earth relief",{"id":96,"title":97},"manhattan-flyover","Manhattan building flyover",{"id":99,"title":100},"sunburst","Zoomable sunburst",{"id":102,"title":103},"large-graph","Large force graph",{"id":105,"title":106},"themes","Theme presets",[2],{"quantile-aggregate":109},{"sources":110,"views":112},{"svelte":111,"python":111},"",{"plot":113},{"previews":114},{"web":115},{"src":116,"srcset":117,"type":123,"width":120,"height":124,"bytes":125,"alt":5},"gallery/quantile-aggregate/preview-1636.0760fd580d.webp",[118,121],[119,120],"gallery/quantile-aggregate/preview-818.bc887d79e2.webp",818,[116,122],1636,"image/webp",412,[126,127],12054,28292],"uses":{"params":["example"]}}]}
