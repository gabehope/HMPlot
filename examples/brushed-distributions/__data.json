{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":11,"nav":12,"exampleIds":106,"examples":107},"example","brushed-distributions",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10,"python":-1},"Brushed distributions","Interaction","Shift-drag to brush 60,000 points in five clusters; violins and box plots of each group's values are recomputed from the brushed rows on every move, with no GPU kernels compiled while dragging.",[5,8,9],"Filter","Distributions","\u003Cscript>\n  import { Data, Plot, Points, Filter, categorical } from \"hmplot\";\nimport { Violin, BoxPlot } from \"hmplot/charts\";\n  // table: 60,000 rows with x, y (to brush), group (five clusters) and value.\n  const scale = categorical({ domain: [\"North\", \"East\", \"South\", \"West\", \"Center\"] });\n\u003C/script>\n\u003CData value={table}>\n  \u003CPlot axes2d>\n    \u003CPoints x=\"x\" y=\"y\" size={1} fill=\"group\" brush maxElements={60000} />\n  \u003C/Plot>\n  \u003CPlot x={{ scale: scale }} axes2d>\n    \u003CFilter where=\"@brushed\">\u003CViolin x=\"group\" y=\"value\" fill=\"group\" />\u003C/Filter>\n  \u003C/Plot>\n  \u003CPlot x={{ scale: scale }} axes2d>\n    \u003CFilter where=\"@brushed\">\u003CBoxPlot x=\"group\" y=\"value\" fill=\"group\" />\u003C/Filter>\n  \u003C/Plot>\n\u003C/Data>",false,[13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103],{"id":14,"title":15},"ten-million-stars","Ten million stars, filtered live",{"id":17,"title":18},"double-gyre","Mixing in a double gyre",{"id":20,"title":21},"globe-tiles","A globe with streamed map tiles",{"id":23,"title":24},"lorenz-attractor","Lorenz attractor",{"id":26,"title":27},"earthquakes","Earthquakes beneath the globe",{"id":29,"title":30},"calculate-matrix","Calculated scatterplot matrix",{"id":32,"title":33},"calculate-large","Large calculated point cloud",{"id":35,"title":36},"interaction-dashboard","Coordinated interaction dashboard",{"i