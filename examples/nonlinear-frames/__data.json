{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","nonlinear-frames",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":10,"python":11},"Nested scales","A child interval maps through its parent’s logarithmic scale.","Composition",[8,9],"Frame","Coordinates","\u003Cscript>\n  import { Plot, Frame, Points, Line } from \"hmplot\";\n  const positions = [[0, 0], [50, 50], [100, 100]];\n\u003C/script>\n\u003CPlot responsive height={420} axes2d\n  x={{domain:[1,1000], transform:\"log\"}} y={{domain:[0,100]}}>\n  \u003CFrame x={{domain:[0,100], range:[10,100]}}\n    y={{domain:[0,100], range:[20,80]}}>\n    \u003CLine position={positions} color=\"#547ba2\" width={2} />\n    \u003CPoints position={positions} fill=\"#7b9865\" size={6} />\n  \u003C/Frame>\n\u003C/Plot>","import hmplot as hm\n\npositions = [[0, 0], [50, 50], [100, 100]]\nwith hm.Plot(axes2d=True, height=420,\n             x={\"domain\": [1, 1000], \"transform\": \"log\"},\n             y={\"domain\": [0, 100]}) as plot:\n    with hm.Frame(x={\"domain\": [0, 100], \"range\": [10, 100]},\n                  y={\"domain\": [0, 100], \"range\": [20, 80]}):\n        hm.Line(position=positions, color=\"#547ba2\", width=2)\n        hm.Points(position=positions, fill=\"#7b9865\", size=6)\nplot",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated int