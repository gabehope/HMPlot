{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":13,"nav":14,"exampleIds":108,"examples":109},"example","selection-compare",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":12},"Multiple selection sets","Interaction","Build two named selection sets in separate projections and inspect their overlap in a third view.",[8,9,10],"Selections","Virtual columns","Linked views","\u003Cscript>\n  const primary = selection(), comparison = selection();\n\u003C/script>\n\u003CData value={observations} key=\"id\">\n  \u003CInteraction columns={{ \"@primary\": primary, \"@comparison\": comparison }}>\n    \u003CPlot>\u003CPoints x=\"x\" y=\"y\" select={primary} hover />\u003C/Plot>\n    \u003CPlot>\u003CPoints x=\"u\" y=\"v\" select={comparison} hover />\u003C/Plot>\n    \u003CPlot>\u003CFilter where={[\"@primary\", \"@comparison\"]} inactive=\"none\">\n      \u003CText x=\"x\" y=\"y\" text=\"id\" />\n    \u003C/Filter>\u003C/Plot>\n  \u003C/Interaction>\n\u003C/Data>","primary, comparison = hm.selection(), hm.selection()\nwith hm.Data(observations, key=\"id\"):\n    with hm.Interaction(columns={\"@primary\": primary, \"@comparison\": comparison}):\n        with hm.Row():\n            with hm.Plot():\n                hm.Points(x=\"x\", y=\"y\", select=primary, hover=True)\n            with hm.Plot():\n                hm.Points(x=\"u\", y=\"v\", select=comparison, hover=True)",false,[15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105],{"id":16,"title":17},"ten-million-stars","Ten million stars, filtered live",{"id":19,"title":20},"double-gyre","Mixing in a double gyre",{"id":22,"title":23},"globe-tiles","A globe with streamed map tiles",{"id":25,"title":26},"lorenz-attractor","Lorenz attractor",{"id":28,"title":29},"earthquakes","Earthquakes beneath the globe",{"id":31,"title":32},"calculate-matrix","Calculated scatterplot matrix",{"id":34,"title":35},"calculate-large","Large ca