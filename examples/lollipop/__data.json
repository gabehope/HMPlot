{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","lollipop",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10,"python":11},"Lollipop chart","Composition","A stem from the baseline to each value, on either side of it, with a point at the end. Lollipop is a built-in template: BarGeometry places each stem, Segments draws the stems and Points the heads.",[8,9],"Compound","Statistical","\u003Cscript>\n  import { Plot } from \"hmplot\";\nimport { Lollipop } from \"hmplot/charts\";\n  const data = {\n    category: [\"Alder\", \"Birch\", \"Cedar\", \"Douglas fir\", \"Elm\", \"Hemlock\", \"Larch\"],\n    value: [18, 31, 12, 44, 26, 9, 37],\n  };\n\u003C/script>\n\u003CPlot data={data} responsive height={360} axes2d y={{ domain: [0, 50] }}>\n  \u003CLollipop x=\"category\" y=\"value\" fill=\"#547ba2\" size={7} />\n\u003C/Plot>","import hmplot as hm\n\ndata = {\"category\": [\"Alder\", \"Birch\", \"Cedar\", \"Douglas fir\", \"Elm\", \"Hemlock\", \"Larch\"],\n        \"value\": [18, 31, 12, 44, 26, 9, 37]}\nwith hm.Plot(data=data, height=360, axes2d=True, y={\"domain\": [0, 50]}) as plot:\n    hm.charts.Lollipop(x=\"category\", y=\"value\", fill=\"#547ba2\", size=7)\nplot",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction-dashboard","Coordinated interaction dashboard",{"id":39,"title":40},"interaction-matrix","Interaction m