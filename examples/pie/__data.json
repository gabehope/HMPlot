{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":13,"nav":14,"exampleIds":108,"examples":109},"example","pie",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":11,"python":12},"Pie chart","Composition","Each region's share of the sales, clockwise from 12 o'clock, labeled with its percentage. Pie is a built-in template: a PieGeometry transform and Rects in a polar Frame, which it places in a Cartesian Plot.",[8,9,10],"Compound","Statistical","Polar","\u003Cscript>\n  import { Plot, Legend } from \"hmplot\";\nimport { Pie } from \"hmplot/charts\";\n  let pie = $state();\n  const data = {\n    region: [\"North\", \"East\", \"South\", \"West\", \"Central\"],\n    sales: [42, 18, 27, 9, 14],\n  };\n\u003C/script>\n\u003CPlot {data} responsive height={380}>\n  \u003CPie bind:this={pie} value=\"sales\" category=\"region\" sectorLabel=\"percent\" hover respond=\"hovered\" />\n  \u003CLegend for={pie} channel=\"fill\" label=\"Region\" position=\"right\" />\n\u003C/Plot>","import hmplot as hm\n\ndata = {\"region\": [\"North\", \"East\", \"South\", \"West\", \"Central\"],\n        \"sales\": [42, 18, 27, 9, 14]}\nwith hm.Plot(data=data, height=380) as plot:\n    pie = hm.charts.Pie(value=\"sales\", category=\"region\", sector_label=\"percent\", hover=True,\n                 respond=\"hovered\")\n    hm.Legend(target=pie, channel=\"fill\", label=\"Region\", position=\"right\")\nplot",false,[15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105],{"id":16,"title":17},"ten-million-stars","Ten million stars, filtered live",{"id":19,"title":20},"double-gyre","Mixing in a double gyre",{"id":22,"title":23},"globe-tiles","A globe with streamed map tiles",{"id":25,"title":26},"lorenz-attractor","Lorenz attractor",{"id":28,"title":29},"earthquakes","Earthquakes beneath the globe",{"id":31,"title":32},"calculate-matrix","Calculated scatterplot matrix",{"id":34,"title":35},"calculate-large","Large calc