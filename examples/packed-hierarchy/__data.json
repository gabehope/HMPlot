{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","packed-hierarchy",{"id":2,"title":4,"description":5,"group":6,"tags":7,"code":10,"python":11},"Circle packing","D3 circle packing sized by leaf values, with centers and radii on Nodes.","Combinations",[8,9],"Pack","Hierarchy","\u003CGraphData>\u003CPack root=\"Root\" value=\"weight\">\u003CNodes>\u003CPoints x=\"x\" y=\"y\" size={multiply('r',2)} sizeUnits=\"data\" />\u003C/Nodes>\u003C/Pack>\u003C/GraphData>","import hmplot as hm\n\nedges = {'source': ['Root', 'Root', 'A', 'A', 'B', 'B'],\n         'target': ['A', 'B', 'A1', 'A2', 'B1', 'B2']}\nnodes = {'id': ['Root', 'A', 'B', 'A1', 'A2', 'B1', 'B2'],\n         'weight': [1, 1, 1, 3, 2, 2, 1],\n         'label': ['', '', '', 'A1', 'A2', 'B1', 'B2']}\nwith hm.Data(edges) as chart:\n    with hm.GraphData(nodes=nodes, edges=edges, node_key='id', source='source', target='target'):\n        with hm.Pack(root='Root', value='weight', padding=0.015):\n            with hm.Plot(width=450, height=450, x={'domain': [0, 1]}, y={'domain': [0, 1]}):\n                with hm.Nodes():\n                    hm.Points(x='x', y='y', size=hm.col.r * 2,\n                                     size_units='data', fill='depth')\n                    hm.Text(x='x', y='y', text='label', size=11)\nchart\n",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id":33,"title":34},"calculate-large","Large calculated point cloud",{"id":36,"title":37},"interaction