{"type":"data","nodes":[null,{"type":"data","data":[{"mode":1,"id":2,"item":3,"paired":12,"nav":13,"exampleIds":107,"examples":108},"example","drag-map",{"id":2,"title":4,"group":5,"description":6,"tags":7,"code":10,"python":11},"Dragging cities on a map","Interaction","Drag a city on a Mercator map: the drag goes back through the projection and writes offsets in degrees; the point and its label both read moved().",[5,8,9],"Drag","Map","\u003CData value={cities} key=\"name\">\n  \u003CPlot type=\"2d\" coordinates=\"spherical\" projection=\"mercator\"\n    x={{ domain: [-180, 180], visible: false }} y={{ domain: [-60, 75], visible: false }}>\n    \u003CGeoJSON data={countries} fill=\"#d8dde3\" />\n    \u003CPoints x={moved(\"lon\")} y={moved(\"lat\")} fill=\"#d62728\" drag />\n    \u003CText x={moved(\"lon\")} y={moved(\"lat\")} text=\"name\" dy={14} />\n  \u003C/Plot>\n\u003C/Data>","import hmplot as hm\n\ncities = hm.Table({\"name\": names, \"lon\": lons, \"lat\": lats}, key=\"name\")\nwith hm.Plot(data=cities, type=\"2d\", coordinates=\"spherical\", projection=\"mercator\",\n             x={\"domain\": [-180, 180], \"show\": False}, y={\"domain\": [-60, 75], \"show\": False}) as plot:\n    hm.GeoJSON(data=countries, fill=\"#d8dde3\")\n    hm.Points(x=hm.moved(\"lon\"), y=hm.moved(\"lat\"), fill=\"#d62728\", drag=True)\n    hm.Text(x=hm.moved(\"lon\"), y=hm.moved(\"lat\"), text=\"name\", dy=14)\nplot\n# cities.offsets: how far each city was dragged, in degrees.",false,[14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,68,71,74,77,80,83,86,89,92,95,98,101,104],{"id":15,"title":16},"ten-million-stars","Ten million stars, filtered live",{"id":18,"title":19},"double-gyre","Mixing in a double gyre",{"id":21,"title":22},"globe-tiles","A globe with streamed map tiles",{"id":24,"title":25},"lorenz-attractor","Lorenz attractor",{"id":27,"title":28},"earthquakes","Earthquakes beneath the globe",{"id":30,"title":31},"calculate-matrix","Calculated scatterplot matrix",{"id"